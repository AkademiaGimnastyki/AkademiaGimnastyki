---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrainerCarousel from '../components/TrainerCarousel.astro';
import PhotoGallery from '@/components/PhotoGallery.astro';
import { Image } from 'astro:assets';

// Importy obrazów z galerii
import foto1Image from '../images/gallery/foto1.jpg';
import foto2Image from '../images/gallery/foto2.jpg';
import foto3Image from '../images/gallery/foto3.jpg';

const pageTitle = "Oferta Zajęć Gimnastycznych | Małopolska Akademia Gimnastyki";
const pageDescription = "Poznaj naszą ofertę zajęć gimnastycznych dla dzieci i młodzieży w Mszanie Dolnej i Nowym Targu. Oferujemy treningi na każdym poziomie zaawansowania, od początkujących po grupy zawodnicze. Sprawdź nasz grafik i zapisz się już dziś!";
---

<Layout title={pageTitle} description={pageDescription}>
  <main>
    <Hero 
      title="Nasza Oferta"
      subtitle="Treningi i Zajęcia"
      backgroundImage="/images/hero/hero oferta.jpg"
    >
      Odkryj różnorodne programy treningowe dostosowane do wieku i umiejętności
    </Hero>

 
    

    <!-- Sekcja: Wprowadzenie do oferty (logo + nagłówek) -->
    <section id="intro-zajecia" class="pt-12 pb-2 sm:pt-4 sm:pb-0 lg:py-36 px-4 sm:px-6 lg:px-8 bg-white text-slate-800">
      <div class="max-w-5xl mx-auto flex flex-col lg:flex-row items-center lg:justify-center gap-12 lg:gap-24 text-center lg:text-left" data-aos="fade-up">
        <!-- Logo Akademii z subtelną poświatą -->
        <div class="relative flex-shrink-0">
          <div class="absolute inset-0 rounded-full blur-3xl bg-gradient-to-br from-[#00b3d4]/40 via-[#e3a1a1]/40 to-violet-400/40 scale-110"></div>
          <img src="/images/logo/logo_akademia.svg" alt="Logo Małopolskiej Akademii Gimnastyki" class="relative w-52 lg:w-64 drop-shadow-xl" loading="lazy" />
        </div>

        <!-- Tekst -->
        <div class="flex-1 max-w-xl lg:max-w-none text-center lg:text-left">
          <h2 class="mt-8 lg:mt-0 text-3xl md:text-4xl lg:text-5xl font-poppins mb-6 lg:mb-12 leading-tight">
            <span class="font-bold">Nasze </span>
            <span class="font-extralight">Zajęcia</span>
          </h2>
          <p class="text-slate-600 mb-8 max-w-prose mx-auto lg:mx-0">
            Odkryj starannie przygotowany program treningowy, który rozwija zwinność, siłę i pewność siebie. Nasze zajęcia prowadzone są w kameralnych grupach, dzięki czemu każdy gimnastyk otrzymuje indywidualne wskazówki i wsparcie profesjonalnych trenerów.
          </p>

          <!-- Metryczki z dedykowanym wrapperem centrującym -->
          <div class="mt-4 flex justify-center lg:justify-start">
            <div class="flex items-center gap-8 text-sm text-slate-500 font-medium">
              <div class="flex flex-col items-center">
                <span class="text-lg font-bold text-slate-900">45-90&nbsp;minut</span>
                <span>Czas trwania zajęć</span>
              </div>
              <div class="h-6 w-px bg-slate-300" aria-hidden="true"></div>
              <div class="flex flex-col items-center">
                <span class="text-lg font-bold text-slate-900">30&nbsp;osób</span>
                <span>Średnia wielkość grupy</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sekcja: Nasz Sprzęt -->
    <section id="sprzet" class="py-6 sm:pt-2 sm:pb-2 lg:py-24 px-4 sm:px-6 lg:px-8 bg-white text-slate-800">
      <div class="max-w-5xl mx-auto flex flex-col-reverse lg:flex-row items-center lg:items-start gap-12 lg:gap-24" data-aos="fade-up">
        <!-- Tekst -->
        <div class="flex-1 max-w-xl lg:max-w-none text-center lg:text-left">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-poppins mb-6 lg:mb-12 leading-tight">
            <span class="font-extralight">Nasz </span>
            <span class="font-bold">Sprzęt</span>
          </h2>
          <p class="text-slate-600 mb-6 max-w-prose mx-auto lg:mx-0">
            Korzystamy wyłącznie z certyfikowanego, profesjonalnego sprzętu gimnastycznego, który zapewnia maksymalne bezpieczeństwo i komfort treningu – od elastycznych mat po solidne poręcze.
          </p>
          <ul class="flex flex-wrap justify-center lg:justify-start gap-4 text-slate-500 font-medium mt-12">
            <li data-equipment="airtrack" class="equipment-item px-4 py-2 border rounded-full cursor-pointer hover:bg-slate-100 bg-[#00b3d4] text-white border-[#00b3d4]">airtrack</li>
            <li data-equipment="batut" class="equipment-item px-4 py-2 border border-slate-300 rounded-full cursor-pointer hover:bg-slate-100">batut</li>
            <li data-equipment="drazek" class="equipment-item px-4 py-2 border border-slate-300 rounded-full cursor-pointer hover:bg-slate-100">drążek</li>
            <li data-equipment="kola" class="equipment-item px-4 py-2 border border-slate-300 rounded-full cursor-pointer hover:bg-slate-100">koła</li>
          </ul>
        </div>
        <!-- Obraz -->
        <div class="flex-shrink-0">
          <img id="equipment-img" src="/images/arts/airtrack.png" alt="Airtrack" class="w-72 lg:w-96 transition-transform duration-700 hover:scale-125" loading="lazy" />

        <script is:inline>
          const equipmentMap = {
            airtrack: '/images/arts/airtrack.png',
            batut: '/images/arts/batut.png',
            drazek: '/images/arts/drazek.png',
            kola: '/images/arts/kola.png',
            mata: '/images/arts/mata.png',
          };
          const equipmentItems = document.querySelectorAll('.equipment-item');
          const equipmentImg = document.getElementById('equipment-img');
          
          // Funkcja do aktywacji elementu sprzętu
          function activateEquipment(item) {
            const key = item.dataset.equipment;
            if (equipmentMap[key]) {
              equipmentImg.src = equipmentMap[key];
            }
            equipmentItems.forEach(i => i.classList.remove('bg-[#00b3d4]','text-white','border-[#00b3d4]'));
            item.classList.add('bg-[#00b3d4]','text-white','border-[#00b3d4]');
          }
          
          // Dodanie obsługi kliknięć
          equipmentItems.forEach(item => {
            item.addEventListener('click', () => {
              activateEquipment(item);
            });
          });
        </script>
        </div>
      </div>
    </section>

    <!-- Sekcja: Przykładowe Ćwiczenia -->
    <section id="cwiczenia" class="relative overflow-hidden pt-8 pb-12 lg:pt-2 lg:pb-16 px-4 sm:px-6 lg:px-8 bg-white text-slate-800">
      <!-- Rozmyte gradientowe plamy w tle -->
      <div class="absolute -left-40 -top-40 w-[600px] h-[600px] rounded-full bg-gradient-to-br from-white via-[#e3a1a1]/40 to-[#00b3d4]/40 blur-3xl -z-10"></div>



      <div class="max-w-5xl mx-auto flex flex-col lg:flex-row items-center gap-12 lg:gap-24 relative">
        <!-- Zdjęcie w okręgu z obramowaniem i białymi pierścieniami -->
        <div class="relative flex-shrink-0">
          <!-- gradientowe plamy pod zdjęciem -->
          <div class="absolute -z-10 -left-28 -top-24">
            <div class="bg-[#a0b9f9] rounded-[50%] w-[277.96px] h-[393.18px] absolute left-0 top-0" style="filter: blur(150px);"></div>
            <div class="bg-[#f2afda] rounded-[50%] w-[224.72px] h-[317.9px] absolute left-[191.19px] top-[24.9px]" style="filter: blur(150px);"></div>
          </div>
          <!-- pusty element utrzymujący rozmiar koła oraz białe pierścienie -->
          <div class="absolute inset-0 rounded-full border border-white/50"></div>
          <div class="absolute inset-3 rounded-full border border-white/40"></div>
          <div class="w-72 h-72 lg:w-80 lg:h-80"></div>
          <Image 
            id="exercise-img" 
            src={foto1Image} 
            alt="Przykładowe ćwiczenie" 
            class="absolute inset-4 rounded-full object-cover w-[calc(100%-2rem)] h-[calc(100%-2rem)]" 
          />
          <!-- Dekoracyjny element art13 -->

        </div>

        <!-- Tekst -->
        <div class="flex-1 text-center lg:text-left">
          <h2 class="flex items-center justify-center lg:justify-start text-3xl md:text-4xl lg:text-5xl font-poppins mb-6 lg:mb-8 leading-tight">
            <div class="flex flex-col mr-6">
              <span class="font-bold leading-tight">Przykładowe</span>
              <span class="font-extralight leading-tight">Ćwiczenia</span>
            </div>
            <img src="/icons/workout.svg" alt="Ikona ćwiczeń" class="hidden lg:inline-block w-24 h-24 ml-8" />
          </h2>
          <p class="text-slate-600 mb-6 max-w-prose mx-auto lg:mx-0">
            Zajęcia gimnastyczne w Małopolskiej Akademii Gimnastyki łączą technikę, zabawę i wyzwania dopasowane do poziomu uczestników. Najmłodsi rozwijają koordynację i
             współpracę podczas skoków przez przeszkody i ćwiczeń z piłkami. Starsze dzieci wzmacniają mięśnie, poprawiają gibkość i uczą się podstawowych elementów gimnastycznych. 
             Młodzież doskonali siłę, precyzję i charakter, trenując wejścia na drążek, akrobacje na ścieżce air track i rzuty przyborami. Każdy trening rozwija ciało i umysł, budując pewność 
             siebie i radość z ruchu. Od pierwszych przewrotów do mistrzowskich układów — każdy ruch oznacza postęp.
          </p>

          <ul class="flex flex-wrap justify-center lg:justify-start gap-6 text-slate-700 font-light">
            <li data-exercise="1" class="exercise-item px-4 py-2 border rounded-full cursor-pointer hover:bg-slate-100 bg-[#00b3d4] text-white border-[#00b3d4]">Siła</li>
            <li data-exercise="2" class="exercise-item px-4 py-2 border border-slate-300 rounded-full cursor-pointer hover:bg-slate-100">Zręczność</li>
            <li data-exercise="3" class="exercise-item px-4 py-2 border border-slate-300 rounded-full cursor-pointer hover:bg-slate-100">Zdrowie</li>
          </ul>
        </div>


      </div>

      <script is:inline define:vars={{ foto1Src: foto1Image.src, foto2Src: foto2Image.src, foto3Src: foto3Image.src }}>
        const exerciseMap = {
          1: foto1Src,
          2: foto2Src,
          3: foto3Src,
        };
        const exerciseItems = document.querySelectorAll('.exercise-item');
        const exerciseImg = document.getElementById('exercise-img');
        exerciseItems.forEach(item => {
          item.addEventListener('click', () => {
            const key = item.dataset.exercise;
            if (exerciseMap[key]) {
              exerciseImg.src = exerciseMap[key];
            }
            exerciseItems.forEach(i => i.classList.remove('bg-[#00b3d4]','text-white','border-[#00b3d4]'));
            item.classList.add('bg-[#00b3d4]','text-white','border-[#00b3d4]');
          });
        });
      </script>

    </section>

    <!-- Sekcja: Nasze Grupy -->
    <section id="grupy" class="pt-10 pb-12 lg:py-32 px-4 sm:px-6 lg:px-8 bg-white text-slate-800" data-aos="fade-up">
      <div class="max-w-6xl mx-auto flex flex-col lg:flex-row items-center lg:items-start gap-12 lg:gap-24">
        <!-- Lewa kolumna: nagłówek i opis -->
        <div class="flex-1 max-w-xl lg:max-w-none text-center lg:text-left">
          <h2 class="mt-8 lg:mt-0 text-3xl md:text-4xl lg:text-5xl font-poppins mb-6 lg:mb-8 leading-tight">
            <span class="font-extralight">Nasze </span>
            <span class="font-bold">Grupy</span>
          </h2>
          <p class="text-slate-600 mb-8 lg:mb-12 max-w-prose mx-auto lg:mx-0">
            W Małopolskiej Akademii Gimnastyki wierzymy, że sukces zaczyna się od treningu dopasowanego do wieku i możliwości.
            Dlatego prowadzimy zajęcia w trzech starannie dobranych grupach wiekowych. Każda z nich ma własny program, cele
            oraz tempo pracy, aby uczestnicy czuli się zmotywowani i bezpiecznie rozwijali swoje umiejętności.
          </p>
          <a href="/grafik" class="inline-block rounded-[75px] border border-brand-text-main px-12 py-3 font-roboto font-medium text-xl text-brand-text-main hover:bg-brand-text-main hover:text-white transition-colors duration-300">Sprawdź Grafik</a>
        </div>

        <!-- Prawa kolumna: listy grup -->
        <ul class="flex flex-col gap-6 w-full max-w-xs mx-auto lg:mx-0 list-none">
          <li class="text-center text-white text-lg font-poppins font-semibold py-4 rounded-full bg-purple-300 transition-all duration-300 hover:scale-110 hover:shadow-lg cursor-pointer">
            Grupa 3–5 lat
          </li>
          <li class="text-center text-white text-lg font-poppins font-semibold py-4 rounded-full bg-purple-400 transition-all duration-300 hover:scale-110 hover:shadow-lg cursor-pointer">
            Grupa 6–7 lat
          </li>
          <li class="text-center text-white text-lg font-poppins font-semibold py-4 rounded-full bg-purple-500 transition-all duration-300 hover:scale-110 hover:shadow-lg cursor-pointer">
            Grupa 8-10 lat
          </li>
          <li class="text-center text-white text-lg font-poppins font-semibold py-4 rounded-full bg-purple-600 transition-all duration-300 hover:scale-110 hover:shadow-lg cursor-pointer">
            Grupa 11+ lat
          </li>
        </ul>
      </div>
    </section>

    <!-- Sekcja: Nasze Lokalizacje -->
    <section id="lokalizacje" class="pt-8 pb-20 lg:pt-16 lg:pb-32 px-4 sm:px-6 lg:px-8 bg-white text-slate-800" data-aos="fade-up">
      <div class="max-w-5xl mx-auto text-center mb-12 lg:mb-20">
        <h2 class="inline-flex items-center justify-center text-3xl md:text-4xl lg:text-5xl font-poppins leading-tight mb-6">
          <span class="font-extralight mr-2">Nasze</span>
          <span class="font-bold">Lokalizacje</span>
          <img src="/icons/geopin.svg" alt="pin" class="w-16 h-16 ml-4" />
        </h2>
        <p class="text-slate-600 max-w-prose mx-auto">
          Poznaj miejsca, w których trenujemy – wygodne sale dostosowane do potrzeb gimnastyki artystycznej i akrobatycznej. Prowadzimy zajęcia w Mszanie Dolnej oraz Nowym Targu. 
        </p>
      </div>

      <!-- Grafika z okręgami i opisami miast -->
      <div class="relative flex flex-col md:flex-row items-center justify-between gap-8 max-w-5xl mx-auto">
        <!-- Nowy Targ (lewa strona) -->
        <div class="order-2 md:order-1 w-full md:w-1/4 text-center md:text-right">
          <div class="mt-4 md:mt-0">
            <h3 class="font-poppins text-xl lg:text-2xl text-slate-800 mb-1">Nowy Targ</h3>
            <p class="text-slate-600 font-medium text-lg">Plac Evry 4</p>
            <p class="text-slate-400 font-light text-lg">I piętro pływalni miejskiej</p>
          </div>
        </div>
        
        <!-- Środkowa część z grafiką -->
        <div class="order-1 md:order-2 w-full md:w-2/4 relative flex items-center justify-center mb-12 md:mb-0">
          <!-- Grafika okręgów -->
          <div class="relative w-64 h-64 md:w-80 md:h-80 lg:w-96 lg:h-96">
            <img src="/icons/localizations.svg" alt="Okręgi lokalizacji" class="w-full h-full object-contain animate-spin-slow" />
            
            <!-- Dekoracyjny blob w środku -->
            <img src="/images/arts/art13.png" alt="Dekoracja" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-36 h-36 md:w-44 md:h-44 lg:w-52 lg:h-52 object-contain transition-transform duration-300 hover:scale-125 z-10" />
            
          </div>
        </div>
        
        <!-- Mszana Dolna (prawa strona) -->
        <div class="order-3 w-full md:w-1/4 text-center md:text-left">
          <div class="mt-4 md:mt-0">
            <h3 class="font-poppins text-xl lg:text-2xl text-slate-800 mb-1">Mszana Dolna</h3>
            <p class="text-slate-600 font-medium text-lg">ul. Józef Marka 2</p>
            <p class="text-slate-400 font-light text-lg">Hala w ZSP (Ogrodnik)</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sekcja: Kadra (Karuzela trenerów) -->
    <TrainerCarousel />

    <!-- Sekcja: Cennik Zajęć -->
    <section class="relative pt-8 pb-8 flex justify-center overflow-visible">
      <div class="relative flex flex-col items-stretch space-y-6 px-4 lg:space-y-0 lg:px-0 lg:block w-full lg:w-[1051.6px] lg:h-[1000px]">
        <!-- Rozmyte elipsy w tle -->
        <div class="hidden lg:block -z-10 bg-[#a0b9f9] rounded-[50%] w-[531.06px] h-[751.18px] absolute left-[257px] top-[206px] blur-[150px]"></div>
        <div class="hidden lg:block -z-10 bg-[#f2afda] rounded-[50%] w-[429.34px] h-[607.36px] absolute left-[622.27px] top-[253.57px] blur-[150px]"></div>

        <!-- Niebieska karta z ceną -->
        <div class="rounded-3xl w-full lg:w-[370px] h-auto lg:h-[550px] lg:absolute lg:left-0 lg:top-[438px] mb-6 lg:mb-0 flex order-3 lg:order-none z-10 flex-col items-center py-10 px-4 text-white transition-all duration-500 ease-out hover:scale-[1.02] hover:-translate-y-1.5" style="
            background: linear-gradient(
                180deg,
                rgba(0, 179, 212, 0.95) 0%,
                rgba(0, 179, 212, 1) 100%
              );
            box-shadow: 0px 7.5px 30px 0px rgba(0, 0, 0, 0.18),
              5.25px 5.25px 30px 0px rgba(0, 179, 212, 0.25);
          ">
          <div class="w-full max-w-sm font-roboto text-white">
            <p class="text-center text-lg font-medium text-white/90 mb-4">Opłata miesięczna</p>
            <div class="space-y-4">
        
              <!-- Lista cen -->
              <div class="space-y-4 text-lg">
                <div class="flex justify-between items-center py-3 border-b border-white/20">
                  <span>45 min × 1x / tydz.</span>
                  <span class="font-bold text-xl">120 zł</span>
                </div>
                <div class="flex justify-between items-center py-3 border-b border-white/20">
                  <span>60 min × 1x / tydz.</span>
                  <span class="font-bold text-xl">140 zł</span>
                </div>
                <div class="flex justify-between items-center py-3 border-b border-white/20">
                  <span>90 min × 1x / tydz.</span>
                  <span class="font-bold text-xl">160 zł</span>
                </div>
                <div class="flex justify-between items-center py-3 border-b border-white/20">
                  <span>60 min × 2x / tydz.</span>
                  <span class="font-bold text-xl">240 zł</span>
                </div>
                <div class="flex justify-between items-center py-3">
                  <span>90 min × 2x / tydz.</span>
                  <span class="font-bold text-xl">280 zł</span>
                </div>
              </div>

              <!-- Zniżki dla rodzeństwa -->
              <div class="pt-3 mt-3 border-t border-white/20 text-center">
                <h4 class="font-poppins font-medium text-medium">Rodzeństwo</h4>
                <div class="space-y-3 text-base mt-1">
                  <div class="flex justify-between items-center">
                    <span>Zniżka na drugie dziecko</span>
                    <span class="font-bold">– 20 zł</span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span>Zniżka na trzecie dziecko</span>
                    <span class="font-bold">– 40 zł</span>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- Biała karta z listą korzyści -->
        <div class="rounded-3xl w-full lg:w-[649px] h-auto lg:h-[550px] lg:absolute lg:left-[391px] lg:top-[438px] px-6 md:px-14 py-8 md:py-10 order-2 lg:order-none z-10 flex flex-col justify-center transition-all duration-500 ease-out hover:scale-[1.01] hover:-translate-y-1" style="
            background: linear-gradient(
                180deg,
                rgba(0, 0, 0, 0) 0%,
                rgba(0, 0, 0, 0.03) 100%
              ),
              linear-gradient(to bottom, #ffffff, #f3f3f3);
            box-shadow: 0px 7.5px 30px 0px rgba(0, 0, 0, 0.18),
              5.25px 5.25px 30px 0px rgba(70, 143, 239, 0.135);
          ">
          <ul class="space-y-6 text-[#575757] text-xl font-poppins mx-auto max-w-md">
            <li class="flex items-center"><svg class="w-6 h-6 text-[#00b2d3] mr-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>4-8 zajęć w miesiącu</li>
            <li class="flex items-center"><svg class="w-6 h-6 text-[#00b2d3] mr-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>intensywny rozwój umiejętności</li>
            <li class="flex items-center"><svg class="w-6 h-6 text-[#00b2d3] mr-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>profesjonalna opieka trenerska</li>
            <li class="flex items-center"><svg class="w-6 h-6 text-[#00b2d3] mr-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>dostęp do sprzętu i sali gimnastycznej</li>
          </ul>
