---
import Layout from '../../layouts/Layout.astro';
import { getBlogPostBySlug } from '../../lib/contentAdapter';
import { documentToHtmlString } from '@contentful/rich-text-html-renderer';
import { BLOCKS, INLINES, MARKS } from '@contentful/rich-text-types';
import { optimizeContentfulImage, generateContentfulResponsiveImages } from '../../utils/imageUtils';



// Generowanie statycznych ścieżek dla wszystkich artykułów
export async function getStaticPaths() {
  try {
    // Importujemy funkcję do pobierania wpisów z Contentful
    const { getBlogEntries } = await import('../../lib/contentful');
    const entries = await getBlogEntries();
    
    // Generujemy ścieżki dla każdego wpisu
    return entries.map(entry => {
      // Bezpieczne pobieranie slug
      const fields = entry.fields as Record<string, any>;
      const slug = fields.slug || entry.sys.id;
      
      return {
        params: { slug },
        props: { slug }
      };
    });
  } catch (error) {
    console.error('Błąd podczas generowania ścieżek:', error);
    return [];
  }
}

// Pobierz dane wpisu na podstawie slug
const { slug } = Astro.params;
const post = await getBlogPostBySlug(slug as string);

// Jeśli nie znaleziono wpisu, przekieruj na stronę bloga
if (!post) {
  return Astro.redirect('/blog');
}

// Formatowanie daty w stylu "8 maja 2025"
const dateFormatter = new Intl.DateTimeFormat('pl-PL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Bezpieczne formatowanie daty
let formattedDate = '';
try {
  const dateObj = post.date instanceof Date ? post.date : new Date(post.date);
  formattedDate = dateFormatter.format(dateObj);
} catch (error) {
  console.error('Błąd formatowania daty:', error);
  formattedDate = 'Data publikacji niedostępna';
}

// Funkcja pomocnicza do renderowania treści Rich Text z Contentful
function renderRichTextContent(content: any) {
  if (!content) return '';
  
  try {
    // Jeśli to string w formacie JSON, spróbuj go sparsować
    let contentObj = content;
    if (typeof content === 'string' && (content.startsWith('{') || content.includes('nodeType'))) {
      contentObj = JSON.parse(content);
    }
    
    // Jeśli to obiekt Rich Text z Contentful
    if (contentObj && contentObj.nodeType === 'document') {
      // Podstawowe opcje renderowania
      const options = {
        renderMark: {
          [MARKS.BOLD]: (text: string) => `<strong>${text}</strong>`,
        },
        renderNode: {
          [BLOCKS.PARAGRAPH]: (node: any, next: any) => `<p class="mb-4 text-gray-700 leading-relaxed">${next(node.content)}</p>`,
          [BLOCKS.HEADING_1]: (node: any, next: any) => `<h1 class="text-3xl font-bold mb-6 text-gray-900">${next(node.content)}</h1>`,
          [BLOCKS.HEADING_2]: (node: any, next: any) => `<h2 class="text-2xl font-bold mb-4 text-gray-900">${next(node.content)}</h2>`,
          [BLOCKS.HEADING_3]: (node: any, next: any) => `<h3 class="text-xl font-bold mb-3 text-gray-900">${next(node.content)}</h3>`,
          [BLOCKS.UL_LIST]: (node: any, next: any) => `<ul class="list-disc mb-6 space-y-3 text-gray-700 pl-6">${next(node.content)}</ul>`,
          [BLOCKS.OL_LIST]: (node: any, next: any) => `<ol class="list-decimal mb-6 space-y-3 text-gray-700 pl-6">${next(node.content)}</ol>`,
          [BLOCKS.LIST_ITEM]: (node: any, next: any) => `<li class="leading-relaxed">${next(node.content)}</li>`,
          [BLOCKS.QUOTE]: (node: any, next: any) => `<blockquote class="border-l-4 border-blue-500 pl-4 py-2 mb-4 italic text-gray-600">${next(node.content)}</blockquote>`,
          [BLOCKS.HR]: () => `<hr class="my-8 border-gray-300" />`,
          [INLINES.HYPERLINK]: (node: any, next: any) => {
            const uri = node.data?.uri || '#';
            const content = next(node.content);
            const isExternal = uri.startsWith('http') || uri.startsWith('https');
            const target = isExternal ? 'target="_blank" rel="noopener noreferrer"' : '';
            return `<a href="${uri}" ${target} class="text-blue-600 hover:text-blue-800 underline hover:no-underline transition-all duration-200">${content}</a>`;
          },
          [INLINES.ENTRY_HYPERLINK]: (node: any, next: any) => {
            const entryId = node.data?.target?.sys?.id;
            const content = next(node.content);
            // Dla linków do innych wpisów - możemy później dodać logikę generowania URL
            return `<a href="/blog/${entryId}" class="text-blue-600 hover:text-blue-800 underline hover:no-underline transition-all duration-200">${content}</a>`;
          },
          [BLOCKS.EMBEDDED_ASSET]: (node: any) => {
            if (node.data?.target?.fields?.file?.url) {
              const url = node.data.target.fields.file.url;
              const alt = node.data.target.fields.title || node.data.target.fields.description || '';
              const fullUrl = url.startsWith('//') ? `https:${url}` : url;
              const optimizedUrl = optimizeContentfulImage(fullUrl, { width: 800, quality: 85 });
              const sources = generateContentfulResponsiveImages(fullUrl);
              
              let pictureHtml = '<picture class="block my-8 mx-auto">';
              sources.forEach(source => {
                const mediaAttr = source.media ? ` media="${source.media}"` : '';
                pictureHtml += `<source srcset="${source.srcset}" type="${source.type}"${mediaAttr}>`;
              });
              pictureHtml += `<img src="${optimizedUrl}" alt="${alt}" class="rounded-lg shadow-lg max-w-full h-auto mx-auto" loading="lazy" decoding="async">`;
              pictureHtml += '</picture>';
              
              return pictureHtml;
            }
            return '';
          },
          [BLOCKS.EMBEDDED_ENTRY]: () => {
            return `<div class="my-4 p-4 bg-gray-50 rounded-lg">Osadzony wpis</div>`;
          }
        }
      };
      
      // Użyj podstawowego renderera Contentful
      return documentToHtmlString(contentObj, options);
    }
    
    // Fallback dla zwykłego tekstu
    return typeof content === 'string' ? content : '';
  } catch (error) {
    return typeof content === 'string' ? content : '';
  }
}



// Renderuj treść
const renderedContent = renderRichTextContent(post.content);

---

<Layout title={`${post.title || 'Wpis na blogu'} - Blog - Małopolska Akademia Gimnastyki`}>
  <main class="pt-24"> <!-- Zwiększony odstęp od góry, aby uniknąć nachodzenia na menu -->
    <article class="max-w-4xl mx-auto px-4 pb-12 sm:px-6 lg:px-8">
      <!-- 1. TYTUŁ -->
      <header class="mb-8">
        <h1 class="text-4xl mb-4">
          <span class="font-bold">{post.title?.split(' ')[0] || 'Wpis'}</span>
          <span class="font-extralight">{post.title?.split(' ').slice(1).join(' ') || 'na blogu'}</span>
        </h1>
        
        <div class="flex items-center mb-2">
          <time datetime={post.date instanceof Date ? post.date.toISOString() : new Date(post.date).toISOString()} class="text-sm text-gray-600 font-medium bg-gray-100 px-3 py-1.5 rounded-md inline-block">
            {formattedDate}
          </time>
        </div>
      </header>

      <!-- 2. GRAFIKA GŁÓWNA -->
      <div class="relative w-full h-72 sm:h-96 md:h-[500px] mb-8 rounded-lg overflow-hidden shadow-lg">
        {post.image && post.image.includes('ctfassets.net') ? (
          <picture class="w-full h-full">
            {generateContentfulResponsiveImages(post.image, [
              { width: 400, viewportWidth: '640px' },
              { width: 600, viewportWidth: '1024px' },
              { width: 1200 }
            ]).map(source => (
              <source 
                srcset={source.srcset} 
                type={source.type} 
                media={source.media} 
              />
            ))}
            <img 
              src={optimizeContentfulImage(post.image, { width: 1200, quality: 85 })}
              alt={post.title || 'Wpis na blogu'} 
              class="w-full h-full object-cover"
              loading="eager"
              decoding="sync"
            />
          </picture>
        ) : (
          <img 
            src={post.image || '/images/hero/bruce-mars-HHXdPG_eTIQ-unsplash.jpg'} 
            alt={post.title || 'Wpis na blogu'} 
            class="w-full h-full object-cover"
            loading="eager"
            decoding="sync"
          />
        )}
      </div>

      <!-- 3. OPIS -->
      <div class="mb-8">
        <p class="text-lg text-gray-700">{post.description || 'Szczegóły wpisu na blogu'}</p>
      </div>

      <!-- 4. TREŚĆ -->
      <div class="prose prose-lg prose-slate max-w-none mb-12 content-contentful">
        {renderedContent ? (
          <div set:html={renderedContent} class="space-y-4" />
        ) : (
          <div class="text-gray-500 text-sm mt-4">
            <p>Treść wpisu nie jest dostępna. Aby edytować pełną treść wpisu, przejdź do panelu Contentful.</p>
          </div>
        )}
      </div>

      <!-- 5. DODATKOWE ZAŁĄCZNIKI (opcjonalnie) -->
      {post.attachments && Array.isArray(post.attachments) && post.attachments.length > 0 && (
        <div class="mt-8 mb-12">
          <h3 class="text-2xl mb-4">
            <span class="font-bold">Dodatkowe</span>
            <span class="font-extralight">materiały</span>
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {post.attachments.map((attachment: any) => (
              <div class="border border-gray-200 rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow">
                {attachment.fields?.file?.url && (
                  <a 
                    href={`https:${attachment.fields.file.url}`} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="flex flex-col items-center"
                  >
                    <div class="w-full h-40 bg-gray-100 rounded-md flex items-center justify-center mb-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                    </div>
                    <span class="text-[#00B3D4] font-medium text-center">
                      {attachment.fields?.title || 'Pobierz załącznik'}
                    </span>
                  </a>
                )}
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- PRZYCISK POWROTU -->
      <div class="mt-12 flex justify-center">
        <a 
          href="javascript:history.back()" 
          class="rounded-[75px] border border-brand-text-main px-8 py-3 sm:px-10 lg:px-12 font-body font-medium text-base sm:text-lg lg:text-xl hover:bg-brand-text-main hover:text-white transition-colors duration-300"
          role="button"
        >
          Powrót
        </a>
      </div>
    </article>
  </main>
</Layout>

<style>
  /* Podstawowe style dla treści Rich Text */
  .prose {
    font-size: 1.125rem;
    line-height: 1.75;
    color: #374151;
    max-width: none;
  }

  /* Nagłówki */
  .prose h1 {
    font-size: 2.25rem;
    font-weight: 700;
    color: #111827;
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-family: 'Poppins', sans-serif;
  }

  .prose h2 {
    font-size: 1.875rem;
    font-weight: 600;
    color: #111827;
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-family: 'Poppins', sans-serif;
  }

  .prose h3 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #111827;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-family: 'Poppins', sans-serif;
  }

  .prose h4, .prose h5, .prose h6 {
    font-weight: 600;
    color: #111827;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-family: 'Poppins', sans-serif;
  }

  /* Paragrafy */
  .prose p {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    color: #4b5563;
    line-height: 1.8;
  }

  /* Listy */
  .prose ul {
    list-style-type: disc;
    list-style-position: outside;
    padding-left: 2rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .prose ol {
    list-style-type: decimal;
    list-style-position: outside;
    padding-left: 2rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
    color: #4b5563;
    line-height: 1.7;
  }

  .prose li::marker {
    color: #00B3D4;
  }

  /* Linki */
  .prose a {
    color: #00B3D4;
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .prose a:hover {
    color: #E3A1A1;
  }

  /* Formatowanie tekstu */
  .prose strong {
    font-weight: 700;
    color: #111827;
  }

  .prose em {
    font-style: italic;
  }

  .prose code {
    background-color: #f3f4f6;
    color: #e11d48;
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-family: monospace;
    font-size: 0.9em;
  }

  /* Cytaty */
  .prose blockquote {
    border-left: 4px solid #00B3D4;
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: #6b7280;
    background-color: #f8fafc;
    border-radius: 0 0.25rem 0.25rem 0;
  }

  /* Obrazy */
  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin: 1.5rem 0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  /* Linie poziome */
  .prose hr {
    margin: 2rem 0;
    border: none;
    height: 1px;
    background-color: #e5e7eb;
  }

  /* Responsywność */
  @media (max-width: 640px) {
    .prose {
      font-size: 1rem;
    }
    
    .prose h1 {
      font-size: 1.875rem;
    }
    
    .prose h2 {
      font-size: 1.5rem;
    }
    
    .prose h3 {
      font-size: 1.25rem;
    }
    
    .prose ul, .prose ol {
      padding-left: 1.5rem;
    }
  }

</style>
