---
import Layout from '../../layouts/Layout.astro';
import { getBlogPostBySlug } from '../../lib/contentAdapter';

// Generowanie statycznych ścieżek dla wszystkich artykułów
export async function getStaticPaths() {
  try {
    // Importujemy funkcję do pobierania wpisów z Contentful
    const { getBlogEntries } = await import('../../lib/contentful');
    const entries = await getBlogEntries();
    
    // Generujemy ścieżki dla każdego wpisu
    return entries.map(entry => {
      // Bezpieczne pobieranie slug
      const fields = entry.fields as Record<string, any>;
      const slug = fields.slug || entry.sys.id;
      
      return {
        params: { slug },
        props: { slug }
      };
    });
  } catch (error) {
    console.error('Błąd podczas generowania ścieżek:', error);
    return [];
  }
}

// Pobierz dane wpisu na podstawie slug
const { slug } = Astro.params;
const post = await getBlogPostBySlug(slug as string);

// Jeśli nie znaleziono wpisu, przekieruj na stronę bloga
if (!post) {
  return Astro.redirect('/blog');
}

// Formatowanie daty w stylu "8 maja 2025"
const dateFormatter = new Intl.DateTimeFormat('pl-PL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Bezpieczne formatowanie daty
let formattedDate = '';
try {
  const dateObj = post.date instanceof Date ? post.date : new Date(post.date);
  formattedDate = dateFormatter.format(dateObj);
} catch (error) {
  console.error('Błąd formatowania daty:', error);
  formattedDate = 'Data publikacji niedostępna';
}

// Funkcja pomocnicza do renderowania treści Rich Text z Contentful
function renderRichTextContent(content: any) {
  if (!content) return '';
  
  try {
    // Jeśli to string w formacie JSON, spróbuj go sparsować
    let contentObj = content;
    if (typeof content === 'string' && (content.startsWith('{') || content.includes('nodeType'))) {
      contentObj = JSON.parse(content);
    }
    
    // Jeśli to obiekt Rich Text z Contentful
    if (contentObj && contentObj.nodeType === 'document') {
      // Proste renderowanie paragrafów i nagłówków
      let html = '';
      
      if (Array.isArray(contentObj.content)) {
        contentObj.content.forEach((node: any) => {
          if (node.nodeType === 'paragraph' && Array.isArray(node.content)) {
            const text = node.content
              .map((textNode: any) => textNode.value || '')
              .join('');
            html += `<p>${text}</p>`;
          } else if (node.nodeType === 'heading-1' && Array.isArray(node.content)) {
            const text = node.content
              .map((textNode: any) => textNode.value || '')
              .join('');
            html += `<h1>${text}</h1>`;
          } else if (node.nodeType === 'heading-2' && Array.isArray(node.content)) {
            const text = node.content
              .map((textNode: any) => textNode.value || '')
              .join('');
            html += `<h2>${text}</h2>`;
          } else if (node.nodeType === 'heading-3' && Array.isArray(node.content)) {
            const text = node.content
              .map((textNode: any) => textNode.value || '')
              .join('');
            html += `<h3>${text}</h3>`;
          } else if (node.nodeType === 'unordered-list' && Array.isArray(node.content)) {
            html += '<ul>';
            node.content.forEach((listItem: any) => {
              if (listItem.nodeType === 'list-item' && Array.isArray(listItem.content)) {
                html += '<li>';
                listItem.content.forEach((paragraph: any) => {
                  if (paragraph.nodeType === 'paragraph' && Array.isArray(paragraph.content)) {
                    const text = paragraph.content
                      .map((textNode: any) => textNode.value || '')
                      .join('');
                    html += text;
                  }
                });
                html += '</li>';
              }
            });
            html += '</ul>';
          }
        });
      }
      
      return html;
    }
    
    // Fallback dla zwykłego tekstu
    return typeof content === 'string' ? content : '';
  } catch (error) {
    console.error('Błąd renderowania treści Rich Text:', error);
    return typeof content === 'string' ? content : '';
  }
}

// Renderuj treść
const renderedContent = renderRichTextContent(post.content);
---

<Layout title={`${post.title || 'Wpis na blogu'} - Blog - Małopolska Akademia Gimnastyki`}>
  <main class="pt-24"> <!-- Zwiększony odstęp od góry, aby uniknąć nachodzenia na menu -->
    <article class="max-w-4xl mx-auto px-4 pb-12 sm:px-6 lg:px-8">
      <!-- 1. TYTUŁ -->
      <header class="mb-8">
        <h1 class="text-4xl mb-4">
          <span class="font-bold">{post.title?.split(' ')[0] || 'Wpis'}</span>
          <span class="font-extralight">{post.title?.split(' ').slice(1).join(' ') || 'na blogu'}</span>
        </h1>
        
        <div class="flex items-center mb-2">
          <time datetime={post.date instanceof Date ? post.date.toISOString() : new Date(post.date).toISOString()} class="text-sm text-gray-600 font-medium bg-gray-100 px-3 py-1.5 rounded-md inline-block">
            {formattedDate}
          </time>
        </div>
      </header>

      <!-- 2. GRAFIKA GŁÓWNA -->
      <div class="relative w-full h-72 sm:h-96 md:h-[500px] mb-8 rounded-lg overflow-hidden shadow-lg">
        <img 
          src={post.image || '/images/hero/bruce-mars-HHXdPG_eTIQ-unsplash.jpg'} 
          alt={post.title || 'Wpis na blogu'} 
          class="w-full h-full object-cover"
        />
      </div>

      <!-- 3. OPIS -->
      <div class="mb-8">
        <p class="text-lg text-gray-700">{post.description || 'Szczegóły wpisu na blogu'}</p>
      </div>

      <!-- 4. TREŚĆ -->
      <div class="prose prose-lg max-w-none mb-12">
        {renderedContent ? (
          <div set:html={renderedContent} />
        ) : (
          <div class="text-gray-500 text-sm mt-4">
            <p>Treść wpisu nie jest dostępna. Aby edytować pełną treść wpisu, przejdź do panelu Contentful.</p>
          </div>
        )}
      </div>

      <!-- 5. DODATKOWE ZAŁĄCZNIKI (opcjonalnie) -->
      {post.attachments && Array.isArray(post.attachments) && post.attachments.length > 0 && (
        <div class="mt-8 mb-12">
          <h3 class="text-2xl mb-4">
            <span class="font-bold">Dodatkowe</span>
            <span class="font-extralight">materiały</span>
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {post.attachments.map((attachment: any) => (
              <div class="border border-gray-200 rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow">
                {attachment.fields?.file?.url && (
                  <a 
                    href={`https:${attachment.fields.file.url}`} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="flex flex-col items-center"
                  >
                    <div class="w-full h-40 bg-gray-100 rounded-md flex items-center justify-center mb-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                    </div>
                    <span class="text-[#00B3D4] font-medium text-center">
                      {attachment.fields?.title || 'Pobierz załącznik'}
                    </span>
                  </a>
                )}
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- PRZYCISK POWROTU -->
      <div class="mt-12 flex justify-center">
        <a 
          href="/blog" 
          class="inline-flex items-center px-6 py-3 rounded-md bg-[#00B3D4] text-white hover:bg-[#E3A1A1] transition-colors duration-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Powrót do bloga
        </a>
      </div>
    </article>
  </main>
</Layout>

<style>
  /* Stylizacja zawartości Markdown i Rich Text */
  .prose h1 {
    font-size: 1.875rem;
    line-height: 2.25rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 700;
  }
  .prose h2 {
    font-size: 1.5rem;
    line-height: 2rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .prose h3 {
    font-size: 1.25rem;
    line-height: 1.75rem;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  .prose p {
    margin-top: 1rem;
    margin-bottom: 1rem;
    color: #4b5563;
  }
  .prose ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
  .prose img {
    border-radius: 0.5rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }
  .prose a {
    color: #00B3D4;
    transition-property: color;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 300ms;
  }
  .prose a:hover {
    color: #E3A1A1;
  }
  
  /* Dodatkowe style dla Rich Text z Contentful */
  .prose blockquote {
    border-left: 4px solid #E3A1A1;
    padding-left: 1rem;
    font-style: italic;
    margin: 1.5rem 0;
    color: #6b7280;
  }
  .prose hr {
    margin: 2rem 0;
    border-color: #e5e7eb;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }
  .prose th,
  .prose td {
    padding: 0.75rem;
    border: 1px solid #e5e7eb;
  }
  .prose th {
    background-color: #f9fafb;
    font-weight: 600;
  }
</style>
