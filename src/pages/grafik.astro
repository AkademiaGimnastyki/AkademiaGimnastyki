---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Calendar from '../components/Calendar.astro';
import ScheduleInfo from '../components/ScheduleInfo.astro';
import Calendar_Nowy_Targ from '../components/Calendar_Nowy_Targ.astro';

const mszanaGroups = [
  { ageRange: "3-5", day: " Gimnastyka ogólnorozwojowa", time: "Środa" },
  { ageRange: "6-7", day: " Gimnastyka ogólnorozwojowa", time: "Środa" },
  { ageRange: "4-7", day: " Taneczna  Gimnastyka artystyczna", time: "Piątek" },
  { ageRange: "8-15", day: " Taneczna  Gimnastyka artystyczna", time: "Piątek" }
];

const nowyTargGroups = [
  { ageRange: "3-5", day: " Gimnastyka ogólnorozwojowa", time: "Poniedziałek" },
  { ageRange: "6-7", day: " Gimnastyka sportowa", time: "Poniedziałek" },
  { ageRange: "8>", day: "Akrobatyka Grupa Brązowa", time: "Czwartek" },
  { ageRange: "8-10", day: "Akrobatyka Grupa Srebrna", time: "Czwartek" },
  { ageRange: "11+", day: "Akrobatyka Grupa Złota", time: "Czwartek" }
];
---

<Layout title="Grafik Zajęć - Małopolska Akademia Gimnastyki">
  <main>
    <Hero 
      title="Harmonogram"
      subtitle="Grafik Zajęć"
      backgroundImage="/images/hero/hero grafik.jpg"
    >
      Sprawdź dostępne terminy i zaplanuj swój trening
    </Hero>

    <!-- Calendar section -->
    <section class="py-12 space-y-24">
      <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl text-center mb-8">
          <span class="font-extralight">Grafik</span>
          <span class="font-bold">Mszana Dolna</span>
        </h2>
        <div class="flex flex-col lg:flex-row gap-8 items-start">
          <div class="w-full lg:w-3/4">
            <Calendar />
          </div>
          <div class="w-full lg:w-1/4">
            <ScheduleInfo
              location="Mszana Dolna, ul Józefa Marka 2"
              groups={mszanaGroups}
            />
          </div>
        </div>
      </div>

      <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl text-center mb-8">
          <span class="font-extralight">Grafik</span>
          <span class="font-bold">Nowy Targ</span>
        </h2>
        <div class="flex flex-col lg:flex-row gap-8 items-start">
          <div class="w-full lg:w-3/4">
            <Calendar_Nowy_Targ />
          </div>
          <div class="w-full lg:w-1/4">
            <ScheduleInfo
              location="Nowy Targ, Plac Evry 4"
              groups={nowyTargGroups}
            />
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>