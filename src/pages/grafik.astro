---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Calendar from '../components/Calendar.astro';
import ScheduleInfo from '../components/ScheduleInfo.astro';
import Calendar_Nowy_Targ from '../components/Calendar_Nowy_Targ.astro';

const mszanaGroups = [
  { ageRange: "3-5", day: "Grupa 1 - Środa", time: "16:30-17:15" },
  { ageRange: "6-7", day: "Grupa 2 - Środa", time: "17:15-18:15" },
  { ageRange: "8-10", day: "Grupa 3 - Środa", time: "18:15-19:15" },
  { ageRange: "11+", day: "Grupa 4 - Środa", time: "19:15-20:45" },
  { ageRange: "4-7", day: "Gim. Artystyczna - Piątek", time: "15:50-16:50" },
  { ageRange: "8+", day: "Gim. Artystyczna - Piątek", time: "16:50-17:50" }
];

const nowyTargGroups = [
  { ageRange: "3-5", day: "Grupa 1 - Poniedziałek", time: "16:00-16:45" },
  { ageRange: "6-7", day: "Grupa 2 - Poniedziałek", time: "16:45-17:45" },
  { ageRange: "8-10", day: "Grupa 3 - Poniedziałek", time: "17:45-18:45" },
  { ageRange: "11+", day: "Grupa 4 - Poniedziałek", time: "18:45-20:15" },
  { ageRange: "6-7", day: "Grupa Brązowa - Czwartek", time: "16:00-17:00" },
  { ageRange: "8-10", day: "Grupa Srebrna - Czwartek", time: "17:00-18:00" },
  { ageRange: "11+", day: "Grupa Złota - Czwartek", time: "18:00-19:30" }
];
---

<Layout title="Grafik Zajęć - Małopolska Akademia Gimnastyki">
  <main>
    <Hero 
      title="Harmonogram"
      subtitle="Grafik Zajęć"
      backgroundImage="/images/hero/hero grafik.jpg"
    >
      Sprawdź dostępne terminy i zaplanuj swój trening
    </Hero>

    <!-- Calendar section -->
    <section class="py-12 space-y-24">
      <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl text-center mb-8">
          <span class="font-extralight">Grafik</span>
          <span class="font-bold">Mszana Dolna</span>
        </h2>
        <div class="flex flex-col lg:flex-row gap-8 items-start">
          <div class="w-full lg:w-3/4">
            <Calendar />
          </div>
          <div class="w-full lg:w-1/4">
            <ScheduleInfo
              location="Mszana Dolna, ul Józefa Marka 2"
              groups={mszanaGroups}
            />
          </div>
        </div>
      </div>

      <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl text-center mb-8">
          <span class="font-extralight">Grafik</span>
          <span class="font-bold">Nowy Targ</span>
        </h2>
        <div class="flex flex-col lg:flex-row gap-8 items-start">
          <div class="w-full lg:w-3/4">
            <Calendar_Nowy_Targ />
          </div>
          <div class="w-full lg:w-1/4">
            <ScheduleInfo
              location="Nowy Targ, Plac Evry 4"
              groups={nowyTargGroups}
            />
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>