---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dziękujemy - Małopolska Akademia Gimnastyki">
  <main class="min-h-[60vh] flex items-center justify-center px-6 text-center">
    <div class="max-w-xl">
      <img src="/images/arts/art15.png" alt="Grafika dekoracyjna" class="mx-auto mb-6 w-32 md:w-48" />
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-poppins mb-6">
        <span class="font-bold">Dziękujemy!</span>
      </h2>
      <p class="text-lg md:text-xl text-gray-700">
        Otrzymaliśmy Twoją wiadomość. Skontaktujemy się z&nbsp;Tobą, aby potwierdzić rezerwację.
      </p>
      <a href="/" class="inline-block mt-8 rounded-full border border-gray-900 px-8 py-3 text-gray-900 hover:bg-gray-900 hover:text-white transition-colors duration-300">
        Wróć na stronę główną
      </a>
    </div>
  </main>
</Layout>
