---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dziękujemy - Małopolska Akademia Gimnastyki">
  <main class="min-h-[60vh] flex items-center justify-center px-6 text-center">
    <div class="max-w-xl">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-poppins mb-6">
        <span class="font-bold">Dziękujemy!</span>
      </h2>
      <p class="text-lg md:text-xl text-brand-text-main">
        Otrzymaliśmy Twoją wiadomość. Skontaktujemy się z&nbsp;Tobą, aby potwierdzić rezerwację.
      </p>
      <a href="/" class="inline-block mt-8 rounded-full border border-brand-text-main px-8 py-3 text-brand-text-main hover:bg-brand-text-main hover:text-white transition-colors duration-300">
        Wróć na stronę główną
      </a>
    </div>
  </main>
</Layout>
