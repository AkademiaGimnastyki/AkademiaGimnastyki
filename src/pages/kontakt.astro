---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SignupForm from '../components/SignupForm.astro';
---

<Layout title="Kontakt - Małopolska Akademia Gimnastyki">
  <main>
    <Hero 
      title="Skontaktuj się"
      subtitle="Zapisy na zajęcia"
      backgroundImage="/images/hero/hero kontakt.jpg"
    >
      Małopolska Akademia Gimnastyki - kontakt i zapisy na zajęcia
    </Hero>


    <div class="max-w-6xl mx-auto flex flex-col lg:flex-row items-center lg:items-start gap-12 lg:gap-24">
      <!-- Lewa kolumna: nagłówek i opis -->
      <div class="flex-1 max-w-xl lg:max-w-none text-center lg:text-center">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-poppins py-8 lg:py-12 leading-tight">
          <span class="font-extralight">Formularz </span>
          <span class="font-bold">Zapisu</span>
        </h2>


    <SignupForm />

    <!-- Sekcja płatności -->
     <section class="py-20 bg-white overflow-visible">
      
      <div class="max-w-xl mx-auto px-6 text-center">


        <p class="mb-8 text-gray-700">Wpłat prosimy dokonywać przelewem bankowym. W&nbsp;tytule przelewu podaj imię i&nbsp;nazwisko uczestnika.</p>
        <div class="bg-white backdrop-blur rounded-2xl shadow-xl p-8">
          <p class="text-sm font-semibold text-gray-500 mb-1">Numer konta</p>
          <p class="font-mono text-2xl font-bold tracking-widest text-brand-accent select-all">12&nbsp;3456&nbsp;7890&nbsp;1234&nbsp;5678&nbsp;9012&nbsp;3456</p>
          <p class="text-sm text-gray-500 mt-2">Bank Przykładowy&nbsp;SA</p>
        </div>
      </div>
    </section>

    <!-- Sekcja danych kontaktowych -->
    <section class="py-16 bg-gradient-to-b from-white via-gray-50 to-white">
      <div class="max-w-6xl mx-auto grid gap-8 sm:grid-cols-2 lg:grid-cols-4 px-6">
        <!-- Mszana Dolna -->
        <div class="group bg-white/80 backdrop-blur-lg rounded-2xl p-8 shadow-lg hover:shadow-2xl transition">
          <span class="flex items-center justify-center w-12 h-12 mb-4 rounded-full bg-brand-accent/10 text-brand-accent group-hover:bg-brand-accent group-hover:text-white transition">
            <!-- Ikona lokalizacji -->
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.25-7.5 11.25-7.5 11.25S4.5 17.75 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
          </span>
          <h3 class="text-xl font-bold mb-1">Mszana&nbsp;Dolna</h3>
          <p class="text-sm text-gray-700 leading-relaxed">
            Małopolska Akademia Gimnastyki<br/>
            ul.&nbsp;Sportowa&nbsp;15<br/>
            34-730&nbsp;Mszana&nbsp;Dolna
          </p>
        </div>
        <!-- Nowy Targ -->
        <div class="group bg-white/80 backdrop-blur-lg rounded-2xl p-8 shadow-lg hover:shadow-2xl transition">
          <span class="flex items-center justify-center w-12 h-12 mb-4 rounded-full bg-brand-accent/10 text-brand-accent group-hover:bg-brand-accent group-hover:text-white transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.25-7.5 11.25-7.5 11.25S4.5 17.75 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
          </span>
          <h3 class="text-xl font-bold mb-1">Nowy&nbsp;Targ</h3>
          <p class="text-sm text-gray-700 leading-relaxed">
            Małopolska Akademia Gimnastyki<br/>
            ul.&nbsp;Gimnastyczna&nbsp;8<br/>
            34-400&nbsp;Nowy&nbsp;Targ
          </p>
        </div>
        <!-- Telefon -->
        <div class="group bg-white/80 backdrop-blur-lg rounded-2xl p-8 shadow-lg hover:shadow-2xl transition">
          <span class="flex items-center justify-center w-12 h-12 mb-4 rounded-full bg-brand-accent/10 text-brand-accent group-hover:bg-brand-accent group-hover:text-white transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75a.75.75 0 01.75-.75H5.7a.75.75 0 01.7.503l1.081 3.244a.75.75 0 01-.217.8l-1.223 1.223a11.044 11.044 0 005.025 5.025l1.223-1.223a.75.75 0 01.8-.217l3.244 1.081a.75.75 0 01.503.7v2.7a.75.75 0 01-.75.75H17.25C9.492 21 3 14.508 3 6.75V6.75z"/></svg>
          </span>
          <h3 class="text-xl font-bold mb-4">Telefon</h3>
          <a href="tel:+48123456789" class="inline-flex items-center gap-2 bg-brand-accent text-white px-5 py-2 rounded-full hover:opacity-90 transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75a.75.75 0 01.75-.75H5.7a.75.75 0 01.7.503l1.081 3.244a.75.75 0 01-.217.8l-1.223 1.223a11.044 11.044 0 005.025 5.025l1.223-1.223a.75.75 0 01.8-.217l3.244 1.081a.75.75 0 01.503.7v2.7a.75.75 0 01-.75.75H17.25C9.492 21 3 14.508 3 6.75V6.75z"/></svg>
            +48&nbsp;123&nbsp;456&nbsp;789
          </a>
        </div>
        <!-- Email -->
        <div class="group bg-white/80 backdrop-blur-lg rounded-2xl p-8 shadow-lg hover:shadow-2xl transition">
          <span class="flex items-center justify-center w-12 h-12 mb-4 rounded-full bg-brand-accent/10 text-brand-accent group-hover:bg-brand-accent group-hover:text-white transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8.25l9 5.25 9-5.25M4.5 6h15A1.5 1.5 0 0121 7.5v9A1.5 1.5 0 0119.5 18h-15A1.5 1.5 0 013 16.5v-9A1.5 1.5 0 014.5 6z"/></svg>
          </span>
          <h3 class="text-xl font-bold mb-4">E-mail</h3>
          <a href="mailto:kontakt@akademiagimnastyki.pl" class="flex items-center justify-center gap-2 bg-brand-accent text-white px-4 py-2 rounded-full hover:opacity-90 transition text-sm sm:text-base whitespace-normal break-all w-full">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8.25l9 5.25 9-5.25M4.5 6h15A1.5 1.5 0 0121 7.5v9A1.5 1.5 0 0119.5 18h-15A1.5 1.5 0 013 16.5v-9A1.5 1.5 0 014.5 6z"/></svg>
            kontakt@akademiagimnastyki.pl
          </a>
        </div>

        <!-- Social media -->
        <div class="flex gap-6 sm:col-span-2 lg:col-span-4 justify-center">
          <!-- Facebook -->
          <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook" class="group bg-white/80 backdrop-blur-lg rounded-2xl p-6 shadow-lg hover:shadow-2xl transition aspect-square flex items-center justify-center text-brand-accent hover:bg-brand-accent hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.522-4.477-10-10-10S2 6.478 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987H7.898v-2.89h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562v1.875h2.773l-.443 2.89h-2.33v6.987C18.343 21.128 22 16.991 22 12z"/></svg>
          </a>
          <!-- Instagram -->
          <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram" class="group bg-white/80 backdrop-blur-lg rounded-2xl p-6 shadow-lg hover:shadow-2xl transition aspect-square flex items-center justify-center text-brand-accent hover:bg-brand-accent hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor"><path d="M7 2C4.243 2 2 4.243 2 7v10c0 2.757 2.243 5 5 5h10c2.757 0 5-2.243 5-5V7c0-2.757-2.243-5-5-5H7zm10 2a3 3 0 013 3v10a3 3 0 01-3 3H7a3 3 0 01-3-3V7a3 3 0 013-3h10zm-5 3c-2.757 0-5 2.243-5 5s2.243 5 5 5 5-2.243 5-5-2.243-5-5-5zm0 2c1.654 0 3 1.346 3 3s-1.346 3-3 3-3-1.346-3-3 1.346-3 3-3zm4.5-.75a1.25 1.25 0 110 2.5 1.25 1.25 0 010-2.5z"/></svg>
          </a>
          <!-- Google Maps -->
          <a href="https://maps.google.com/?q=Ma%C5%82opolska+Akademia+Gimnastyki" target="_blank" rel="noopener" aria-label="Google Maps" class="group bg-white/80 backdrop-blur-lg rounded-2xl p-6 shadow-lg hover:shadow-2xl transition aspect-square flex items-center justify-center text-brand-accent hover:bg-brand-accent hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-3.162 19.478v-6.897H6.5v-2.89h2.338V9.797c0-2.314 1.381-3.59 3.498-3.59.998 0 2.042.176 2.042.176v2.237h-1.15c-1.136 0-1.49.705-1.49 1.424v1.713h2.533l-.404 2.89h-2.13v6.897A10 10 0 1012 2z"/></svg>
          </a>
        </div>
      </div>
    </section>

   
  </main>
</Layout>