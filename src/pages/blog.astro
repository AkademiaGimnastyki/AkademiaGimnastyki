---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BlogCard from '../components/BlogCard.astro';
import { getBlogPosts, ContentSource } from '../lib/contentAdapter';

// Korzystamy z Contentful jako głównego źródła treści
// Lokalne wpisy są używane tylko jako fallback, gdy Contentful jest niedostępny
const contentSource = ContentSource.CONTENTFUL;

// Pobierz wpisy bloga z Contentful
const posts = await getBlogPosts(contentSource);

// Informacja o aktualnym źródle treści (tylko do celów deweloperskich)
let sourceInfo = "Contentful CMS";
// W przypadku zmiany źródła treści na lokalne, zmień również tę informację
---

<Layout title="Blog - Małopolska Akademia Gimnastyki">
  <main>
    <Hero 
      title="Nasz"
      subtitle="Blog"
      backgroundImage="/images/hero/hero blog.jpg"
    >
      Aktualności, porady i ciekawostki ze świata gimnastyki
    </Hero>
    
    <section class="py-12 px-4 sm:px-6 lg:px-8 mx-auto max-w-7xl">
      <div class="mb-10 text-center">
        <h2 class="text-3xl mb-4">
          <span class="font-bold">Najnowsze</span>
          <span class="font-extralight">wpisy</span>
        </h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Zapraszamy do lektury artykułów z naszego bloga. Znajdziesz tutaj aktualności z życia Akademii, porady dotyczące treningu oraz ciekawostki ze świata gimnastyki.</p>
        
        {/* Informacja o źródle treści - tylko dla celów deweloperskich */}
        <div class="mt-2 text-xs text-gray-400 italic">
          Źródło treści: {sourceInfo}
        </div>
      </div>
      
      {posts.length === 0 ? (
        <div class="text-center py-12">
          <p class="text-lg text-gray-600">Brak wpisów na blogu. Zapraszamy wkrótce!</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <BlogCard
              title={post.title}
              description={post.description || 'Kliknij, aby przeczytać więcej'}
              date={post.date instanceof Date ? post.date : new Date(post.date)}
              image={post.image || '/images/hero/bruce-mars-HHXdPG_eTIQ-unsplash.jpg'}
              url={`/blog/${post.slug}/`}
            />
          ))}
        </div>
      )}
    </section>
  </main>
</Layout>