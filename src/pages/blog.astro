---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BlogCard from '../components/BlogCard.astro';
import { getBlogPosts } from '../lib/contentAdapter';

// Pobierz wpisy bloga z Contentful
const posts = await getBlogPosts();
---

<Layout title="Aktualności - Małopolska Akademia Gimnastyki">
  <main>
    <Hero 
      title="Aktualności"
      backgroundImage="/images/hero/hero blog.jpg"
    >
      Aktualności, porady i ciekawostki ze świata gimnastyki
    </Hero>
    
    <section class="py-24 px-4 sm:px-6 lg:px-8 mx-auto max-w-7xl">
      <div class="mb-20 text-center">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-poppins mb-6 lg:mb-12 leading-tight">
          <span class="font-bold">Najnowsze</span>
          <span class="font-extralight">wpisy</span>
        </h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Zapraszamy do śledzenia na bieżąco aktualności z życia Akademii. Znajdziesz tutaj także porady dotyczące treningu oraz ciekawostki ze świata gimnastyki.</p>
      </div>
      
      {posts.length === 0 ? (
        <div class="text-center py-12">
          <p class="text-lg text-gray-600">Brak wpisów w aktualnościach. Zapraszamy wkrótce!</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <BlogCard
              title={post.title}
              description={post.description || 'Kliknij, aby przeczytać więcej'}
              date={post.date instanceof Date ? post.date : new Date(post.date)}
              image={post.image || '/images/hero/hero blog.jpg'}
              url={`/blog/${post.slug}/`}
            />
          ))}
        </div>
      )}
    </section>
  </main>
</Layout>