---
import Layout from '../layouts/Layout.astro';

const pageTitle = "404: Strona nie znaleziona | Małopolska Akademia Gimnastyki";
const pageDescription = "Ups! Strona, której szukasz, nie istnieje. Wróć na stronę główną Małopolskiej Akademii Gimnastyki.";
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="flex items-center justify-center min-h-[calc(100vh-200px)] text-center px-4 bg-brand-white">
    <div class="max-w-md">
      <h1 class="text-9xl font-bold font-heading text-brand-olive">404</h1>
      <h2 class="mt-4 text-4xl font-poppins font-bold text-brand-text">Strona nie znaleziona</h2>
      <p class="mt-4 text-lg text-brand-text-light">
        Przepraszamy, ale strona, której szukasz, mogła zostać usunięta, zmieniła nazwę lub nigdy nie istniała.
      </p>
      <div class="mt-10">
        <a href="/" class="bg-brand-white border-2 border-brand-olive text-brand-olive hover:bg-brand-olive hover:text-white rounded-full font-body font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-olive/50 py-3 px-8 text-lg transition-colors duration-200">
          Wróć na stronę główną
        </a>
      </div>
    </div>
  </main>
</Layout>
