---
interface Props {
  variant?: 'primary' | 'secondary';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
}

const { 
  variant = 'primary',
  href,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center min-w-[200px] px-8 py-3 text-lg font-medium text-white rounded-full cursor-pointer transition-all duration-300 ease-in-out hover:scale-120 hover:drop-shadow-mag';
---

{
  href ? (
    <a 
      href={href} 
      class:list={[baseStyles, className]} 
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button 
      type={type} 
      class:list={[baseStyles, className]} 
      {...rest}
    >
      <slot />
    </button>
  )
}

<style>
  a, button {
    position: relative;
    z-index: 10;
    transform-origin: center;
    backface-visibility: hidden;
  }

  a:hover, button:hover {
    transform: scale(1.2);
  }

  a:active, button:active {
    transform: scale(0.95);
  }
</style>