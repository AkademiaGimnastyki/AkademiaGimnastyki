---
interface Props {
  calendarUrl?: string;
}

const { 
  calendarUrl = "https://calendar.google.com/calendar/embed?src=eaf4a46ad72c26da1f264b8905ad91b6fc57e14962a17cb9a08688e016f7d04b%40group.calendar.google.com&ctz=Europe%2FWarsaw"
} = Astro.props;
---

<div class="bg-white rounded-[32px] shadow-xl overflow-hidden h-full">
  <div class="relative w-full h-full min-h-[750px]">
    <iframe
      src={calendarUrl}
      class="absolute inset-0 w-full h-full border-0"
      style="border: 0; overflow: hidden;"
    ></iframe>
  </div>
</div>

<style>
  iframe {
    background-color: transparent;
  }
</style>
