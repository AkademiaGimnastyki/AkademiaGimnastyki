---
const groups = [
  "Grupa Początkująca 3-5 lat (Mszana Dolna)",
  "Grupa Średniozaawansowana 6-10 lat (Nowy Targ)",
  "Grupa Zaawansowana 11-17 lat (Mszana Dolna)"
];
---

<form 
  name="signup"
  method="POST"
  action="/dziekujemy/"
  data-netlify="true"
  data-netlify-honeypot="bot-field"
  class="max-w-2xl mx-auto space-y-6 p-6 bg-white rounded-lg shadow-lg"
>
  <!-- Ukryte pola Netlify -->
  <input type="hidden" name="form-name" value="signup">
  <input type="text" name="bot-field" class="hidden">

  <!-- Imię i Nazwisko -->
  <div class="flex flex-col">
    <label class="text-left text-gray-900 mb-2 font-medium">Imię i Nazwisko *</label>
    <input 
      type="text" 
      name="name" 
      required
      class="w-full p-3 border border-gray-900 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent"
    >
  </div>

  <!-- Email i Telefon -->
  <div class="space-y-6">
    <div class="flex flex-col">
      <label class="text-left text-gray-900 mb-2 font-medium">Email *</label>
      <input
        type="email"
        name="email"
        required
        class="w-full p-3 border border-gray-900 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent"
      >
    </div>
    <div class="flex flex-col">
      <label class="text-left text-gray-900 mb-2 font-medium">Telefon</label>
      <input
        type="tel"
        name="phone"
        class="w-full p-3 border border-gray-900 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent"
      >
    </div>
  </div>

  <!-- Wybór Grupy -->
  <div class="flex flex-col">
    <label class="text-left text-gray-900 mb-2 font-medium">Grupa *</label>
    <select
      name="group"
      required
      class="w-full p-3 border border-gray-900 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent appearance-none bg-white bg-[url('data:image/svg+xml;charset=UTF-8,%3csvg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'%23000000\' stroke-width=\'2\' stroke-linecap=\'round\' stroke-linejoin=\'round\'%3e%3cpolyline points=\'6 9 12 15 18 9\'%3e%3c/polyline%3e%3c/svg%3e')] bg-no-repeat bg-[length:20px_20px] bg-[right_1rem_center]"
    >
      <option value="">-- Wybierz grupę --</option>
      {groups.map(group => (
        <option value={group} class="p-2">{group}</option>
      ))}
    </select>
  </div>

  <!-- Dodatkowe Uwagi -->
  <div class="flex flex-col">
    <label class="text-left text-gray-900 mb-2 font-medium">Uwagi</label>
    <textarea
      name="message"
      rows="4"
      class="w-full p-3 border border-gray-900 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent"
    ></textarea>
  </div>

  <!-- Przycisk CTA -->
  <button
    type="submit"
    class="rounded-full border border-gray-900 px-12 py-3 font-roboto font-medium text-xl text-gray-900 hover:bg-gray-900 hover:text-white transition-colors duration-300"
  >
    Zapisz się na zajęcia
  </button>
</form>
