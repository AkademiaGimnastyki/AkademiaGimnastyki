---
// Importujemy tylko to, co jest używane
import GalleryLightbox from './GalleryLightbox';

interface ImageData {
  default: {
    src: string;
  };
}

// Importujemy wszystkie zdjęcia z folderu placeholders
const placeholderImages = await import.meta.glob<ImageData>('/public/images/placeholders/*.jpg', { eager: true });
const images = Object.values(placeholderImages).map((image) => ({
  src: image.default.src,
  alt: 'Zdjęcie z galerii Akademii Gimnastyki'
}));

// Preloadujemy pierwsze 5 zdjęć
const preloadImages = images.slice(0, 5);
---

<section 
  class="w-full px-4 py-12 sm:px-6 lg:px-8"
  data-aos="fade-up"
  data-aos-duration="1000"
>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
    {images.map((image: { src: string; alt: string }, index: number) => (
      <div 
        class="relative group cursor-pointer overflow-hidden rounded-lg"
        data-aos="zoom-in"
        data-aos-delay={index * 100}
      >
        <div 
          class="absolute -inset-1 bg-gradient-to-r from-[#00b3d4] to-[#e3a1a1] rounded-lg opacity-0 group-hover:opacity-50 transition-opacity duration-300"
          style="filter: blur(20px);"
        />
        <div class="relative aspect-[4/3] overflow-hidden rounded-lg transition-transform duration-300 group-hover:scale-105 group-hover:shadow-lg">
          <img
            src={image.src}
            alt={image.alt}
            width="400"
            height="300"
            loading={index < 5 ? "eager" : "lazy"}
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-300"
          />
        </div>
      </div>
    ))}
  </div>
</section>

<!-- Preload pierwszych 5 zdjęć -->
{preloadImages.map((image: { src: string; alt: string }) => (
  <link rel="preload" as="image" href={image.src} />
))}

<div id="lightbox-root"></div>

<script>
  const lightboxRoot = document.getElementById('lightbox-root');
  const galleryItems = document.querySelectorAll('.group');

  function showLightbox(imageUrl: string) {
    if (!lightboxRoot) return;
    
    const event = new CustomEvent('showLightbox', {
      detail: { imageUrl }
    });
    lightboxRoot.dispatchEvent(event);
  }

  galleryItems.forEach(item => {
    item.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const img = target.querySelector('img');
      if (img) {
        showLightbox(img.src);
      }
    });
  });
</script>

<GalleryLightbox client:load />

<style>
  .group {
    transform: translateZ(0);
    backface-visibility: hidden;
  }
</style>
