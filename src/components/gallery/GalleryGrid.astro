---
// Importujemy tylko to, co jest używane
import GalleryLightbox from './GalleryLightbox';
import { getImage } from 'astro:assets';

interface ImageData {
  default: any;
}

// Importujemy wszystkie zdjęcia z folderu gallery w src
const galleryImages = import.meta.glob<ImageData>('/src/images/gallery/*.{jpg,png,jpeg}', { eager: true });

// Optymalizujemy obrazy
const optimizedImages = await Promise.all(
  Object.values(galleryImages).map(async (image) => {
    const optimized = await getImage({
      src: image.default,
      widths: [400, 800],
      formats: ['avif', 'webp'],
      aspectRatio: '4:3',
      fit: 'cover',
    });
    
    return {
      src: optimized.src,
      srcset: optimized.attributes.srcset,
      width: optimized.attributes.width,
      height: optimized.attributes.height,
      alt: 'Zdjęcie z galerii Akademii Gimnastyki'
    };
  })
);

// Preloadujemy pierwsze 5 zdjęć
const preloadImages = optimizedImages.slice(0, 5);
---

<section 
  class="w-full px-4 py-12 sm:px-6 lg:px-8"
  data-aos="fade-up"
  data-aos-duration="1000"
>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
    {optimizedImages.map((image, index: number) => (
      <div 
        class="relative group cursor-pointer overflow-hidden rounded-lg"
        data-index={index}
        data-aos="zoom-in"
        data-aos-delay={index * 100}
      >
        <div 
          class="absolute -inset-1 bg-gradient-to-r from-[#00b3d4] to-[#e3a1a1] rounded-lg opacity-0 group-hover:opacity-50 transition-opacity duration-300"
          style="filter: blur(20px);"
        />
        <div class="relative aspect-[4/3] overflow-hidden rounded-lg transition-transform duration-300 group-hover:scale-105 group-hover:shadow-lg">
          <img
            src={image.src}
            srcset={image.srcset}
            width={image.width}
            height={image.height}
            alt={image.alt}
            loading={index < 5 ? "eager" : "lazy"}
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-300"
          />
        </div>
      </div>
    ))}
  </div>
</section>

<!-- Preload pierwszych 5 zdjęć -->
{preloadImages.map((image) => (
  <link rel="preload" as="image" href={image.src} />
))}

<div id="lightbox-root"></div>

<script>
  const lightboxRoot = document.getElementById('lightbox-root');
  const galleryItems = document.querySelectorAll('.group');

  function showLightbox(imageUrl: string, index: number) {
    if (!lightboxRoot) return;
    
    const event = new CustomEvent('showLightbox', {
      detail: { imageUrl, index }
    });
    lightboxRoot.dispatchEvent(event);
  }

  galleryItems.forEach(item => {
    item.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const img = target.querySelector('img');
      if (img) {
        const indexAttr = target.getAttribute('data-index');
        const imageIndex = indexAttr ? parseInt(indexAttr, 10) : 0;
        showLightbox(img.src, imageIndex);
      }
    });
  });
</script>

<GalleryLightbox client:load />

<style>
  .group {
    transform: translateZ(0);
    backface-visibility: hidden;
  }
</style>
