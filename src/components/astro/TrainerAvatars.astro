---
interface Trainer {
  name: string;
  image: string;
}

interface Props {
  trainers: Trainer[];
}

const { trainers } = Astro.props;
---

<div className="flex -space-x-4">
  {trainers.map((trainer) => (
    <div className="relative">
      <img
        src={trainer.image}
        alt={trainer.name}
        className="w-12 h-12 sm:w-14 sm:h-14 rounded-full border-2 border-white object-cover hover:z-10 transition-all duration-300"
        title={trainer.name}
      />
    </div>
  ))}
</div>

<style>
  img {
    transition: transform 0.3s ease-in-out;
  }
  img:hover {
    transform: scale(1.1);
  }
</style>
