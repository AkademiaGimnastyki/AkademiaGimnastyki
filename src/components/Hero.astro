---
import { Image } from 'astro:assets';
import TrainerAvatars from './ui/TrainerAvatars.astro';
import HeroButtons from './ui/HeroButtons.astro';

interface Props {
  signupUrl?: string;
  title?: string;
  subtitle?: string;
  backgroundImage?: string;
  showButtons?: boolean;
  showAvatars?: boolean;
}

const { 
  title = "Klub Sportowy",
  subtitle = "Małopolska Akademia Gimnastyki",
  backgroundImage = "/images/hero/hero o nas.jpg",
  showButtons = true,
  showAvatars = true,
  signupUrl
} = Astro.props;

const trainers = [
  {
    name: "Paulina Wojciechowska",
    role: "Trener Główny",
    image: "/images/trainers/trainer1.jpg"
  },
  {
    name: "Marcin Wojciechowski",
    role: "Trener główny",
    image: "/images/trainers/trainer2.jpg"
  }
];
---

<div class="relative w-full max-w-[1920px] mx-auto">
  <div class="relative mx-4 sm:mx-6 lg:mx-8 my-6">
    <div class="rounded-[32px] overflow-hidden" transition:name="hero-container">
      <div class="relative w-full aspect-[16/9]">
        <Image
          src={backgroundImage}
          alt="Dzieci trenujące gimnastykę w Małopolskiej Akademii Gimnastyki"
          class="absolute inset-0 w-full h-full object-cover"
          width={1920}
          height={1080}
          format="avif"
          quality={85}
          sizes="(max-width: 640px) 640px, (max-width: 1024px) 1024px, (max-width: 1536px) 1536px, 1920px"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
          transition:name="hero-image"
        />
        <!-- Overlay -->
        <div 
          class="absolute inset-0 bg-gradient-to-r from-black/50 to-black/30"
          transition:name="hero-overlay"
        ></div>

        <!-- Content Grid -->
        <div class="absolute inset-0 grid grid-rows-[auto_1fr_auto] p-6 sm:p-8 md:p-10">
          <!-- Top Row - Logo -->
          <div class="h-12 xs:h-16 md:h-24">
            <a href="/o-nas" class="inline-block" transition:name="hero-logo">
              <Image
                src="/images/logo/logo_akademia.svg"
                alt="Małopolska Akademia Gimnastyki - Logo"
                class="w-auto h-10 xs:h-12 sm:h-16 md:h-20 lg:h-24 transition-all duration-300 ease-in-out hover:scale-110 hover:drop-shadow-mag cursor-pointer hover:-translate-y-1"
                loading="eager"
                decoding="sync"
                width={240}
                height={96}
                format="svg"
              />
            </a>
          </div>

          <!-- Middle Row - Main Content -->
          <div class="flex flex-col items-center justify-center text-center" transition:name="hero-content">
            <h1 class="text-xl xs:text-2xl sm:text-3xl md:text-4xl lg:text-6xl text-white mb-4 font-poppins" data-aos="fade-up">
              <span class="font-bold">{title}</span><br />
              <span class="font-extralight">{subtitle}</span>
            </h1>
            <p class="hidden md:block text-xl md:text-2xl mb-8 font-light max-w-3xl mx-auto text-white" data-aos="fade-up" data-aos-delay="100">
              <slot>Profesjonalne zajęcia gimnastyczne dla dzieci i młodzieży</slot>
            </p>
            
            {showButtons && (
              <div class="mt-8 hidden sm:block" data-aos="fade-up" data-aos-delay="200">
                <HeroButtons signupUrl={signupUrl ?? '/kontakt'} />
              </div>
            )}
          </div>

          <!-- Bottom Row - Social Links -->
          <div class="h-24 flex items-end justify-between" transition:name="hero-footer">
            <div class="space-y-4 hidden lg:block">
              {showAvatars && <TrainerAvatars trainers={trainers} />}
              <div class="flex space-x-2 sm:space-x-4">
                <a
                  href="https://www.facebook.com/profile.php?id=100072345243817"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="pointer-events-auto bg-white/10 hover:bg-white/20 text-white p-1.5 sm:p-2 md:p-3 rounded-full transition-all duration-300"
                >
                  <svg class="w-4 h-4 sm:w-5 sm:h-5 md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                  </svg>
                </a>
                <a
                  href="https://www.instagram.com/malopolskaakademiagimnastyki?fbclid=IwY2xjawLaKQ9leHRuA2FlbQIxMABicmlkETBRRWFZM2c0TlVJaDRKaG9jAR4sRjNcU8n07NwrqQgSQDlpIZiW5OvL81tSBTTKe_HgSmqFbUp8Mwf99SkfgA_aem_ZL3FQnskJz8_7OXsGJQaDw"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="pointer-events-auto bg-white/10 hover:bg-white/20 text-white p-1.5 sm:p-2 md:p-3 rounded-full transition-all duration-300"
                >
                  <svg class="w-4 h-4 sm:w-5 sm:h-5 md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
