---
interface Props {
  calendarUrl?: string;
}

const { 
  calendarUrl = "https://calendar.google.com/calendar/embed?src=df24f4b69a6dca41513d9056c9acc8a01503f6845229aa84bed4d7d956d994fa%40group.calendar.google.com&ctz=Europe%2FWarsaw"
} = Astro.props;
---

<div class="bg-white rounded-[32px] shadow-xl overflow-hidden h-full">
  <div class="relative w-full h-full min-h-[700px]">
    <iframe
      src={calendarUrl}
      class="absolute inset-0 w-full h-full border-0"
      style="border: 0; overflow: hidden;"
    ></iframe>
  </div>
</div>

<style>
  iframe {
    background-color: transparent;
  }
</style>

