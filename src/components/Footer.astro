---
import AuroraBackground from "./ui/AuroraBackground.astro";

const logoPath = '/images/logo/logo_akademia.svg';
---

<footer class="relative w-full bg-white pt-16 pb-32">
  <!-- Gradient background -->
  <div 
    class="absolute inset-0 w-full h-full opacity-50 mb-8 bg-gradient-to-b from-transparent via-brand-accent/15 to-purple-500/15 blur-3xl"
  ></div>

  <div class="max-w-7xl mx-auto px-4 relative">
    <!-- Logo section -->
    <div class="absolute left-0 top-0 overflow-hidden bg-black rounded-[37px] w-[320px] h-[360px] flex flex-col items-center justify-center hover:scale-105 hover:shadow-2xl transition-all duration-300">
      <AuroraBackground className="absolute inset-0 z-0 opacity-80 pointer-events-none" amplitude={0.6} blend={0.6} />
      <img 
        src={logoPath}
        alt="Logo Akademii Gimnastyki"
        class="relative z-10 w-[140px] h-auto mb-4"
        loading="eager"
        decoding="async"
      />  
      <div class="relative z-10 text-center text-white">
        <h2 class="text-xl">
          <span class="font-bold">Małopolska</span><br />
          <span class="font-extralight">Akademia<br />Gimnastyki</span>
        </h2>
        <div class="mt-4 w-[160px] h-[3px] bg-gradient-to-r from-brand-primary to-brand-accent"></div>
        <p class="mt-4 font-thin text-xl">Klub Sportowy</p>
      </div>
    </div>

    <!-- Navigation columns -->
    <div class="grid grid-cols-3 gap-x-32 ml-[360px]">
      <!-- Na skróty -->
      <div>
        <h3 class="text-xl mb-6">
          <span class="font-bold">Na</span>
          <span class="font-extralight">skróty</span>
        </h3>
        <nav class="flex flex-col space-y-4">
          <a href="/o-nas" class="text-lg hover:text-brand-primary transition-colors">O nas</a>
          <a href="/oferta" class="text-lg hover:text-brand-primary transition-colors">Oferta</a>
          <a href="/galeria" class="text-lg hover:text-brand-primary transition-colors">Galeria</a>
          <a href="/blog" class="text-lg hover:text-brand-primary transition-colors">Aktualności</a>
          <a href="/kontakt" class="text-lg hover:text-brand-primary transition-colors">Kontakt</a>
          <a href="/regulamin-klubu" class="text-lg hover:text-brand-primary transition-colors">Regulamin</a>
        </nav>
      </div>

           <!-- Nasze lokalizacje -->
           <div>
            <h3 class="text-xl mb-6">
              <span class="font-bold">Nasze</span>
              <span class="font-extralight">lokalizacje</span>
            </h3>
            <div class="space-y-6">
              <div class="flex items-start">
                <svg class="w-4 h-4 text-brand-primary mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                <div class="text-lg ml-2">
                  <p class="font-bold">Mszana Dolna</p>
                  <p class="text-brand-text-main/70 whitespace-nowrap">ul. Spadochroniarzy 2</p>
                </div>
              </div>
              <div class="flex items-start">
                <svg class="w-4 h-4 text-brand-primary mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                <div class="text-lg ml-2">
                  <p class="font-bold">Nowy Targ</p>
                  <p class="text-brand-text-main/70 whitespace-nowrap">ul. Spadochroniarzy 2</p>
                </div>
              </div>
            </div>
          </div>
    
      <!-- Kontakt -->
      <div>
        <h3 class="text-xl mb-6">
          <span class="font-bold">Kontakt</span>
        </h3>
        <div class="space-y-6">
          <div class="flex items-center">
            <img 
              src="/icons/mail.svg" 
              alt="E-mail" 
              class="w-5 h-5 text-brand-primary flex-shrink-0" />
            <a href="mailto:akademia.kontakt@gmail.com" class="text-lg ml-2 hover:text-brand-primary transition-colors whitespace-nowrap">
              akademia.kontakt@gmail.com
            </a>
          </div>
          <div class="flex items-center">
            <svg class="w-5 h-5 text-brand-primary flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:+48232242424" class="text-lg ml-2 hover:text-brand-primary transition-colors">
              <span class="font-bold">+48</span> 535 124 492
            </a>
          </div>
          <div class="flex items-center space-x-6 mt-8">
            <!-- Ikonki social media -->
            <a href="https://www.facebook.com/people/Akademia-Gimnastyki-Mszana-Dolna/100072345243817/" aria-label="Facebook" target="_blank" rel="noopener" class="hover:text-brand-primary transition-colors">
              <svg class="w-5 h-5 text-brand-primary" viewBox="0 0 24 24" fill="currentColor">
                <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.99 3.66 9.12 8.44 9.88v-6.99h-2.54v-2.89h2.54V9.42c0-2.51 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.25c-1.23 0-1.61.77-1.61 1.56v1.88h2.74l-.44 2.89h-2.3v6.99C18.34 21.12 22 16.99 22 12z" />
              </svg>
            </a>
            <a href="https://www.instagram.com/malopolskaakademiagimnastyki?fbclid=IwY2xjawLaKQ9leHRuA2FlbQIxMABicmlkETBRRWFZM2c0TlVJaDRKaG9jAR4sRjNcU8n07NwrqQgSQDlpIZiW5OvL81tSBTTKe_HgSmqFbUp8Mwf99SkfgA_aem_ZL3FQnskJz8_7OXsGJQaDw" aria-label="Instagram" target="_blank" rel="noopener" class="hover:text-brand-primary transition-colors">
              <svg class="w-5 h-5 text-brand-primary" viewBox="0 0 24 24" fill="currentColor">
                <path d="M7 2C4.243 2 2 4.243 2 7v10c0 2.757 2.243 5 5 5h10c2.757 0 5-2.243 5-5V7c0-2.757-2.243-5-5-5H7zm10 2a3 3 0 013 3v10a3 3 0 01-3 3H7a3 3 0 01-3-3V7a3 3 0 013-3h10zm-5 3a5 5 0 100 10 5 5 0 000-10zm0 2a3 3 0 110 6 3 3 0 010-6zm4.5-3a1.5 1.5 0 110 3 1.5 1.5 0 010-3z" />
              </svg>
            </a>
            <a href="https://g.co/kgs/xum6T2g" aria-label="Google" target="_blank" rel="noopener" class="hover:text-brand-primary transition-colors">
              <svg class="w-5 h-5 text-brand-primary" viewBox="0 0 24 24" fill="currentColor">
                <path d="M21.35 11.1h-9.17v2.98h5.63c-.24 1.34-.98 2.48-2.1 3.24v2.68h3.4c2-1.83 3.24-4.53 3.24-7.79 0-.66-.05-1.31-.16-1.94z" />
                <path d="M12.18 21.43c2.84 0 5.22-.94 6.96-2.55l-3.4-2.68c-.96.65-2.19 1.03-3.56 1.03-2.73 0-5.04-1.84-5.86-4.3H3.78v2.7a9.25 9.25 0 008.4 5.8z" />
                <path d="M6.32 12c0-.79.13-1.56.37-2.3V6.98H3.78A9.26 9.26 0 003 12c0 1.47.35 2.86.97 4.02l2.37-2.02A5.48 5.48 0 016.32 12z" />
                <path d="M12.18 4.57c1.54 0 2.93.53 4.03 1.58l3.02-2.93A9.13 9.13 0 0012.18 2a9.25 9.25 0 00-8.4 5.8l2.37 2.02c.82-2.46 3.13-4.3 5.86-4.3z" />
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
  <div class="pb-4"></div>
</footer>
