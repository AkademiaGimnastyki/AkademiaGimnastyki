<form class="flex flex-col space-y-4">
  <label class="flex flex-col">
    <span>Imię</span>
    <input type="text" class="border border-gray-300 p-2 rounded" required />
  </label>
  <label class="flex flex-col">
    <span>Nazwisko</span>
    <input type="text" class="border border-gray-300 p-2 rounded" required />
  </label>
  <label class="flex flex-col">
    <span>Adres e-mail</span>
    <input type="email" class="border border-gray-300 p-2 rounded" required />
  </label>
  <label class="flex flex-col">
    <span>Numer telefonu</span>
    <input type="tel" class="border border-gray-300 p-2 rounded" required />
  </label>
  <button type="submit" class="bg-blue-500 text-white p-2 rounded hover:bg-blue-600">Zarejestruj się</button>
</form>
