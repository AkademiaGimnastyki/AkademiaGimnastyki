---
import { Image } from 'astro:assets';
import foto0Image from '../images/gallery/foto0.jpg';
import foto3Image from '../images/gallery/foto3.jpg';
import foto5Image from '../images/gallery/foto5.jpg';

const features = [
  {
    badge: "Zajęcia grupowe",
    title: '<span class="font-bold">Gimnastyka sportowa</span> dla <span class="font-extralight">dzieci i młodzieży</span>',
    description: "Prowadzimy zajęcia w małych grupach, gdzie każde dziecko otrzymuje indywidualną uwagę. Nasi trenerzy, absolwenci AWF, łączą profesjonalizm z pasją do gimnastyki.",
    image: foto5Image
  },
  {
    badge: "Treningi indywidualne",
    title: '<span class="font-bold">Personalizowane</span> <span class="font-thin">podejście do rozwoju</span>',
    description: "Oferujemy treningi one-on-one, gdzie program jest dostosowany do indywidualnych potrzeb i celów. Idealne dla osób chcących szybko poprawić swoje umiejętności.",
    image: foto0Image
  },
  {
    badge: "Akrobatyka sportowa",
    title: '<span class="font-bold">Rozwój sprawności</span> <span class="font-extralight">i koordynacji</span>',
    description: "Zajęcia z akrobatyki sportowej to świetny sposób na rozwój sprawności fizycznej, równowagi i koordynacji ruchowej. Uczymy bezpiecznych technik i stopniowo zwiększamy poziom trudności.",
    image: foto3Image
  }
];
---

<section class="w-full bg-gray-50/50">
  <div class="w-full py-8 lg:py-16">
    <div class="container mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-12 items-center">
        <div class="flex flex-col justify-center h-full">
          <div class="swiper-text-content relative min-h-[300px] lg:min-h-[400px] flex flex-col">
            <div class="flex-grow">
              {features.map((feature, index) => (
                <div class={`feature-text absolute w-full ${index === 0 ? 'active' : ''}`} data-index={index}>
                  <div class="space-y-6 max-w-xl">
                    <span class="inline-flex items-center justify-center w-auto min-w-[11rem] h-[2.6875rem] px-6 py-2 text-base leading-[160%] tracking-[0.04em] font-normal text-[#4a4a4a] bg-white border border-[#4a4a4a] rounded-[5.75rem] font-roboto whitespace-nowrap overflow-hidden text-ellipsis">
                      {feature.badge}
                    </span>
                    <h2 class="font-poppins text-2xl md:text-3xl lg:text-4xl xl:text-5xl tracking-tighter font-bold">
                      <Fragment set:html={feature.title} />
                    </h2>
                    <p class="font-roboto text-base lg:text-lg leading-relaxed text-muted-foreground">
                      {feature.description}
                    </p>
                  </div>
                </div>
              ))}
            </div>
            <!-- Dots navigation -->
            <div class="flex justify-center gap-4 mt-8">
              {features.map((_, index) => (
                <button
                  class={`feature-dot w-2 h-2 rounded-full bg-gray-300 transition-colors duration-300 ${index === 0 ? 'active' : ''}`}
                  data-index={index}
                  aria-label={`Przejdź do slajdu ${index + 1}`}
                >
                </button>
              ))}
            </div>
          </div>
        </div>
        <div class="w-full">
          <div class="swiper feature-carousel overflow-hidden rounded-[50px]">
            <div class="swiper-wrapper">
              {features.map((feature) => (
                <div class="swiper-slide">
                  <div class="relative w-full aspect-video">
                    <Image 
                      src={feature.image}
                      alt={feature.title}
                      width={1000}
                      height={667}
                      class="w-full h-full object-cover"
                    />
                    <div class="absolute inset-0 bg-black/10"></div>
                  </div>
                </div>
              ))}
            </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .feature-text {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s ease-in-out, transform 0.8s ease-in-out;
    pointer-events: none;
    position: absolute;
    width: 100%;
  }

  .feature-text.active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .feature-dot {
    transition: all 0.3s ease-in-out;
  }

  .feature-dot.active {
    background-color: #00b3d4;
    transform: scale(1.5);
  }

  .swiper-slide {
    opacity: 0.4;
    transition: opacity 0.8s ease-in-out;
  }

  .swiper-slide-active {
    opacity: 1;
  }

  /* Swiper custom styles */
  .swiper-button-next,
  .swiper-button-prev {
    color: #00b3d4 !important;
    transition: transform 0.3s ease-in-out;
  }

  .swiper-button-next:hover,
  .swiper-button-prev:hover {
    transform: scale(1.1);
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Navigation, Autoplay, EffectFade } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/effect-fade';

  function initSwiper() {
    const swiper = new Swiper('.feature-carousel', {
      modules: [Navigation, Autoplay, EffectFade],
      slidesPerView: 1,
      effect: "fade",
      fadeEffect: {
        crossFade: true
      },
      speed: 800,
      loop: true,
      autoplay: {
        delay: 4500,
        disableOnInteraction: false,
        pauseOnMouseEnter: false,
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
    });

    // Handle text animations and dot synchronization
    const featureTexts = document.querySelectorAll('.feature-text') || [];
    const featureDots = document.querySelectorAll('.feature-dot') || [];
    
    // Initialize first slide
    if (featureTexts?.[0]) featureTexts[0].classList.add('active');
    if (featureDots?.[0]) featureDots[0].classList.add('active');

    // Update active states on slide change
    swiper.on('slideChange', () => {
      if (featureTexts && featureDots) {
        featureTexts.forEach((text) => text?.classList?.remove('active'));
        featureDots.forEach((dot) => dot?.classList?.remove('active'));
        
        const currentText = featureTexts[swiper.realIndex];
        const currentDot = featureDots[swiper.realIndex];
        
        if (currentText) currentText.classList.add('active');
        if (currentDot) currentDot.classList.add('active');
      }
    });

    // Add click handlers for dots
    featureDots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = parseInt(dot.getAttribute('data-index') || '0');
        swiper.slideToLoop(index);
      });
    });

    // Start autoplay
    swiper.autoplay.start();
  }

  document.addEventListener('DOMContentLoaded', initSwiper);
  // Re-initialize when Astro swaps pages
  document.addEventListener('astro:page-load', initSwiper);
</script>
