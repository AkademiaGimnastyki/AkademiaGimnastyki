---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrainerAvatars from './TrainerAvatars.astro';
import NavigationButtons from '../NavigationButtons.astro';

const trainers = [
  {
    name: "Anna Kowalska",
    role: "Główny trener",
    image: "/images/trainers/trainer1.jpg"
  },
  {
    name: "Marta Nowak",
    role: "Asystent trenera",
    image: "/images/trainers/trainer2.jpg"
  }
];
---

<BaseLayout>
  <div className="relative w-full max-w-[1920px] mx-auto">
    <div className="relative mx-4 sm:mx-6 lg:mx-8 my-6">
      <div className="rounded-[32px] overflow-hidden bg-white">
        <div className="relative aspect-[16/9]">
          <!-- Background Image -->
          <img
            src="/images/hero/main.jpg"
            alt="Tło sekcji"
            className="absolute inset-0 w-full h-full object-cover"
          />
          
          <!-- Overlay -->
          <div className="absolute inset-0 bg-gradient-to-r from-black/50 to-black/30"></div>

          <!-- Content Grid -->
          <div className="absolute inset-0 grid grid-rows-[auto_1fr_auto] p-6 sm:p-8 md:p-10">
            <!-- Top Row - Logo -->
            <div className="h-24">
              <a href="/o-nas" className="inline-block">
                <img
                  src="/images/logo/logo_akademia.svg"
                  alt="Małopolska Akademia Gimnastyki - Logo"
                  className="w-auto h-16 sm:h-20 md:h-24 transition-all duration-300 ease-in-out hover:scale-110 hover:drop-shadow-mag cursor-pointer hover:-translate-y-1"
                  width="240"
                  height="96"
                />
              </a>
            </div>

            <!-- Middle Row - Main Content -->
            <div className="flex flex-col items-center justify-center text-center">
              <h1 className="text-3xl sm:text-4xl md:text-5xl lg:text-7xl text-white mb-4 sm:mb-8">
                <span className="block font-bold">Małopolska Akademia</span>
                <span className="block mt-2 font-thin tracking-wide">Gimnastyki</span>
              </h1>
              
              <div className="mt-8">
                <NavigationButtons />
              </div>
            </div>

            <!-- Bottom Row - Social Links -->
            <div className="h-24 flex items-end justify-between">
              <div className="space-y-4">
                <TrainerAvatars trainers={trainers} />
              </div>
              <div class="relative z-10 mt-6 flex gap-4">
                <a
                  href="https://instagram.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-600 hover:text-[#00b3d4] transition-colors duration-300"
                >
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                  </svg>
                </a>
                <a
                  href="https://facebook.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-600 hover:text-[#00b3d4] transition-colors duration-300"
                >
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .logo-container {
    display: inline-block;
    transition: transform 0.3s ease-in-out;
  }

  .logo-container:hover {
    transform: scale(1.1) translateY(-5px);
  }

  .logo-image {
    filter: drop-shadow(0 0 0 transparent);
    transition: filter 0.3s ease-in-out;
  }

  .logo-container:hover .logo-image {
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.1));
  }
</style>
