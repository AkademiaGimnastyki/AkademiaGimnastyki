---
const { pdfPath, fileName, buttonText } = Astro.props;
---

<a
  href={pdfPath}
  download={fileName}
  class="inline-block rounded-[75px] border border-brand-text-main px-12 py-3 font-roboto font-medium text-xl text-brand-text-main hover:bg-brand-text-main hover:text-white transition-colors duration-300"
>
  {buttonText}
</a>

