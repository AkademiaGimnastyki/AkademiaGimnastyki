---
interface NavItem {
  name: string;
  shortName?: string;
  url: string;
  icon: string;
}

interface Props {
  items: NavItem[];
  className?: string;
}

const { items, className = "" } = Astro.props;
// Usuń końcowy ukośnik z pathname (oprócz samego "/") aby ścieżka była spójna między buildem statycznym (Netlify dodaje "/") a dev-serverem.
const rawPath = Astro.url.pathname;
const currentPath = rawPath !== "/" ? rawPath.replace(/\/$/, "") : "/";
const activeItem = items.find(item => {
  const itemPath = item.url !== "/" ? item.url.replace(/\/$/, "") : "/";
  return itemPath === currentPath;
}) ?? items[0];
---

<div
  class:list={[
    "fixed bottom-0 sm:top-0 left-1/2 -translate-x-1/2 mb-4 sm:mb-6 sm:pt-6 w-[98%] sm:w-auto max-w-full pointer-events-none",
    className
  ]}
  style="z-index: 100;"
>
  <nav class="flex items-center justify-between sm:justify-center sm:gap-3 bg-[#9E75DC]/60 border border-border backdrop-blur-lg py-1 px-1 rounded-full shadow-lg overflow-x-auto max-w-full no-scrollbar pointer-events-auto scroll-smooth">
    {
      items.map((item) => {
        const isActive = activeItem?.name && item.name === activeItem.name;
        return (
          <a
            href={item.url}
            data-nav-item
            class:list={[
              "relative cursor-pointer text-[10px] xs:text-xs sm:text-sm font-semibold px-1 xs:px-2 sm:px-6 py-2 rounded-full transition-all duration-300",
              "text-white hover:text-white/80 flex-1 sm:flex-none sm:min-w-[100px] text-center",
              "flex items-center justify-center pointer-events-auto",
              isActive && "bg-white/10 text-white nav-active"
            ]}
          >
            {/* Tekst na desktop */}
            <span class="hidden md:inline whitespace-nowrap pointer-events-auto">{item.name}</span>
            {/* Tekst na tablet/większe mobile */}
            <span class="hidden sm:inline md:hidden whitespace-nowrap pointer-events-auto">{item.shortName || item.name}</span>
            {/* Tekst na małe mobile */}
            <span class="hidden xs:inline sm:hidden whitespace-nowrap pointer-events-auto text-[10px]">{item.shortName || item.name}</span>
            {/* Ikony tylko na bardzo małych ekranach */}
            <span class="xs:hidden w-5 h-5 flex items-center justify-center pointer-events-auto" set:html={item.icon} />
            {isActive && (
              <div class="absolute inset-0 w-full bg-primary/5 rounded-full -z-10 pointer-events-none">
                <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-1 bg-primary rounded-t-full pointer-events-none">
                  <div class="absolute w-12 h-6 bg-primary/20 rounded-full blur-md -top-2 -left-2 pointer-events-none" />
                  <div class="absolute w-8 h-6 bg-primary/20 rounded-full blur-md -top-1 pointer-events-none" />
                  <div class="absolute w-4 h-4 bg-primary/20 rounded-full blur-sm top-0 left-2 pointer-events-none" />
                </div>
              </div>
            )}
          </a>
        );
      })
    }
  </nav>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  /* Poprawka dla ikon na mobile */
  .md\\:hidden svg {
    width: 100%;
    height: 100%;
    pointer-events: auto;
  }
  
  /* Optymalizacja dla bardzo małych ekranów */
  @media (max-width: 374px) {
    nav {
      padding-left: 0.125rem;
      padding-right: 0.125rem;
      gap: 0;
    }
    
    [data-nav-item] {
      font-size: 8px;
      padding-left: 0.25rem;
      padding-right: 0.25rem;
      flex: 1;
      max-width: none;
    }
  }
  
  /* Optymalizacja dla ekranów 375px - 639px */
  @media (min-width: 375px) and (max-width: 639px) {
    nav {
      padding-left: 0.25rem;
      padding-right: 0.25rem;
    }
    
    [data-nav-item] {
      flex: 1;
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }
  }
  
  /* Poprawa scrollowania na touch devices */
  nav {
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
  }
</style>

<script>
  // Minimalne JavaScript tylko dla płynnej nawigacji
  document.querySelectorAll('[data-nav-item]').forEach(item => {
    item.addEventListener('click', (e) => {
      const link = e.currentTarget as HTMLAnchorElement;
      e.preventDefault();
      window.location.href = link.href;
    });
  });
</script>
