---
interface NavItem {
  name: string;
  url: string;
  icon: string;
}

interface Props {
  items: NavItem[];
  className?: string;
}

const { items, className = "" } = Astro.props;
const currentPath = Astro.url.pathname;
const activeItem = items.find(item => item.url === currentPath) ?? items[0];
---

<div
  class:list={[
    "fixed bottom-0 sm:top-0 left-1/2 -translate-x-1/2 mb-6 sm:pt-6 w-[95%] sm:w-auto max-w-full pointer-events-none",
    className
  ]}
  style="z-index: 100;"
>
  <nav class="flex items-center gap-1 sm:gap-3 bg-[#9E75DC]/50 border border-border backdrop-blur-lg py-1 px-1 rounded-full shadow-lg overflow-x-auto max-w-full no-scrollbar pointer-events-auto">
    {
      items.map((item) => {
        const isActive = activeItem?.name && item.name === activeItem.name;
        return (
          <a
            href={item.url}
            data-nav-item
            class:list={[
              "relative cursor-pointer text-xs sm:text-sm font-semibold px-3 sm:px-6 py-2 rounded-full transition-all duration-300",
              "text-white hover:text-white/80 min-w-[60px] sm:min-w-[100px] text-center shrink-0",
              "flex items-center justify-center pointer-events-auto",
              isActive && "bg-white/10 text-white nav-active"
            ]}
          >
            <span class="hidden md:inline whitespace-nowrap pointer-events-auto">{item.name}</span>
            <span class="md:hidden w-6 h-6 flex items-center justify-center pointer-events-auto" set:html={item.icon} />
            {isActive && (
              <div class="absolute inset-0 w-full bg-primary/5 rounded-full -z-10 pointer-events-none">
                <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-1 bg-primary rounded-t-full pointer-events-none">
                  <div class="absolute w-12 h-6 bg-primary/20 rounded-full blur-md -top-2 -left-2 pointer-events-none" />
                  <div class="absolute w-8 h-6 bg-primary/20 rounded-full blur-md -top-1 pointer-events-none" />
                  <div class="absolute w-4 h-4 bg-primary/20 rounded-full blur-sm top-0 left-2 pointer-events-none" />
                </div>
              </div>
            )}
          </a>
        );
      })
    }
  </nav>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  /* Poprawka dla ikon na mobile */
  .md\\:hidden svg {
    width: 100%;
    height: 100%;
    pointer-events: auto;
  }
</style>

<script>
  // Minimalne JavaScript tylko dla płynnej nawigacji
  document.querySelectorAll('[data-nav-item]').forEach(item => {
    item.addEventListener('click', (e) => {
      const link = e.currentTarget as HTMLAnchorElement;
      e.preventDefault();
      window.location.href = link.href;
    });
  });
</script>
