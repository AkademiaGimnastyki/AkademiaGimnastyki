---
import Button from './Button.astro';

interface Props {
  class?: string;
  signupUrl?: string;
}

const { class: className, signupUrl = '/kontakt' } = Astro.props;
---

<div class:list={['relative flex flex-col sm:flex-row gap-6 mt-8', className]}>
  <a href="/oferta">
    <Button
      variant="default"
      class="relative z-20 bg-brand-primary/80 hover:bg-brand-accent text-white rounded-full px-8 py-3 backdrop-blur-md hover:scale-105 hover:shadow-lg transition-all duration-300"
    >
      Poznaj naszą ofertę
    </Button>
  </a>
  <a href={signupUrl}>
    <Button
      variant="default"
      class="relative z-20 bg-brand-accent/80 hover:bg-brand-primary text-white rounded-full px-8 py-3 backdrop-blur-md hover:scale-105 hover:shadow-lg transition-all duration-300"
    >
      Zapisz się 
    </Button>
  </a>
</div>
