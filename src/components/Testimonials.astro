---
import { Image } from 'astro:assets';
import 'swiper/css';
import 'swiper/css/effect-fade';
import 'swiper/css/navigation';
import 'swiper/css/pagination';

const testimonials = [
  // Stan 1
  [
    {
      title: "Przyjazne miejsce",
      content: "Akademia to wyjątkowe miejsce, gdzie każde dziecko czuje się jak w domu. Nasza córka nie tylko rozwija swoje umiejętności gimnastyczne, ale także zyskała więcej pewności siebie. Trenerzy tworzą niesamowitą atmosferę, łącząc profesjonalizm z ciepłym podejściem do dzieci. Szczególnie doceniamy indywidualne podejście do każdego małego gimnastyka oraz regularne informacje o postępach.",
      author: "Joanna, Mama 10-letniej Zuzi"
    },
    {
      title: "Profesjonalne podejście",
      content: "Z pełnym przekonaniem polecam Akademię wszystkim rodzicom. Poziom nauczania jest naprawdę imponujący, a trenerzy potrafią w fantastyczny sposób zmotywować dzieci do wysiłku. Nasza córka zrobiła ogromne postępy w ciągu ostatniego roku. Dodatkowo, sala jest świetnie wyposażona, a zajęcia zawsze są doskonale przygotowane. To, co najbardziej cenimy, to fakt, że dzieci uczą się nie tylko gimnastyki, ale także dyscypliny i współpracy.",
      author: "Marcin, Tata 8-letniej Zosi"
    },
    {
      title: "Świetna organizacja",
      content: "To, co wyróżnia Akademię, to perfekcyjna organizacja zajęć i profesjonalny sprzęt. Każde zajęcia są dokładnie zaplanowane, a dzieci mają możliwość korzystania z najwyższej jakości wyposażenia. Trenerzy dbają o bezpieczeństwo, jednocześnie zachęcając do pokonywania własnych granic. Widzimy, jak nasza córka z radością uczestniczy w każdych zajęciach i jak dumna jest ze swoich postępów.",
      author: "Katarzyna"
    }
  ],
  // Stan 2
  [
    {
      title: "Rozwój pasji",
      content: "Akademia pomogła mojemu synowi oraz córce rozwinąć prawdziwą pasję do gimnastyki. Bardzo polecam wszystkim rodzicom, a szczególne dla rodziców o małych dzieciach. Zajęcia są różnorodne i dostosowane do poziomu zaawansowania każdego dziecka.",
      author: "Marta, Mama Kacpra i Patrycji"
    },
    {
      title: "Bezpieczeństwo",
      content: "Bardzo doceniam dbałość o bezpieczeństwo dzieci podczas zajęć. Trenerzy są czujni i profesjonalni, a sala świetnie wyposażona.",
      author: "Anna, Mama 7-letniej Hani"
    },
    {
      title: "Wszechstronny rozwój",
      content: "Zajęcia w Akademii to nie tylko gimnastyka, ale także nauka systematyczności, odpowiedzialności i pracy zespołowej. Polecam każdemu rodzicowi!",
      author: "Paulina, Mama Marka"
    }
  ],
  // Stan 3
  [
    {
      title: "Motywujące zajęcia",
      content: "Trenerzy potrafią świetnie zmotywować dzieci do ćwiczeń. Nasza córka zawsze wraca z zajęć pełna energii i chęci do dalszego treningu.",
      author: "Karolina, Mama 8-letniej Mai"
    },
    {
      title: "Przyjazne miejsce",
      content: "Akademia to bardzo przyjazne miejsce dla dzieci. Panuje tu świetna atmosfera, a trenerzy mają świetne podejście do młodych gimnastyków.",
      author: "Joanna, Mama 10-letniej Zuzi"
    },
    {
      title: "Widoczne efekty",
      content: "Po roku zajęć widzimy ogromną różnicę w sprawności fizycznej naszej córki. Poprawiła się jej koordynacja, gibkość i pewność siebie.",
      author: "Magdalena, Mama 9-letniej Natalii"
    }
  ]
];
---

<div class="mt-24 lg:h-[879px] md:h-[700px] sm:h-[600px] h-[500px] relative w-full max-w-[1920px] mx-auto overflow-visible" data-aos="fade-up" data-aos-duration="1000">
  <div class="rounded-[100px] w-full h-full absolute left-0 top-0 bg-gradient-to-b from-[rgba(155,77,206,1)] to-[rgba(255,255,255,1)]">
    <!-- Blur effects -->
    <div class="bg-[#a0b9f9] rounded-[50%] lg:w-[732px] lg:h-[596px] md:w-[400px] md:h-[350px] sm:w-[300px] sm:h-[250px] w-[200px] h-[180px] absolute lg:left-[411px] md:left-[200px] sm:left-[100px] left-[50px] lg:top-12 md:top-8 sm:top-6 top-4" style="filter: blur(150px)"></div>
    <div class="bg-[#f2afda] rounded-[50%] lg:w-[650px] lg:h-[529.72px] md:w-[350px] md:h-[300px] sm:w-[250px] sm:h-[200px] w-[150px] h-[130px] absolute lg:left-[928px] md:left-[500px] sm:left-[250px] left-[150px] lg:top-[59.82px] md:top-[40px] sm:top-[30px] top-[20px]" style="filter: blur(150px)"></div>

    <!-- Header -->
    <div class="absolute left-1/2 -translate-x-1/2 lg:top-[111px] md:top-[80px] sm:top-[60px] top-[40px] text-center w-full px-4">
      <h2 class="lg:text-[50px] md:text-[40px] sm:text-[32px] text-[28px] leading-[160%] text-white" data-aos="fade-up" data-aos-delay="200">
        <span class="font-bold">Co mówią</span>
        <span class="font-extralight"> o nas klienci?</span>
      </h2>
      <p class="lg:text-xl md:text-lg sm:text-base text-sm leading-[160%] text-white mt-4" data-aos="fade-up" data-aos-delay="300">Opinie o Małopolskiej Akademii Gimnastyki</p>
    </div>

    <!-- Testimonials -->
    <div class="swiper testimonials-carousel absolute lg:top-[297px] md:top-[220px] sm:top-[180px] top-[140px] w-full">
      <div class="swiper-wrapper">
        {testimonials.map((group) => (
          <div class="swiper-slide">
            <!-- Desktop: 3 opinie obok siebie -->
            <div class="hidden lg:flex justify-center gap-[48px] py-8">
              {group.map((testimonial) => (
                <div class="bg-white/10 backdrop-blur-sm rounded-[60px] p-8 max-w-[380px] w-full border border-white/20 shadow-lg hover:bg-white/15 transition-all duration-300 hover:scale-105 hover:shadow-xl">
                  <h3 class="text-2xl font-bold text-white mb-4 lg:text-left lg:px-0 px-4 text-center">{testimonial.title}</h3>
                  <p class="text-white/90 leading-relaxed mb-6 text-sm custom-scrollbar overflow-y-auto max-h-[120px] lg:text-left lg:px-0 px-4 text-center">{testimonial.content}</p>
                  <p class="text-white/70 text-sm font-medium lg:text-left lg:px-0 px-4 text-center">{testimonial.author}</p>
                </div>
              ))}
            </div>
            <!-- Mobile/Tablet: pojedyncze opinie -->
            <div class="lg:hidden flex flex-col gap-4 md:px-12 sm:px-16 px-20 py-4">
              {group.map((testimonial, index) => (
                <div class={`testimonial-mobile ${index === 0 ? 'block' : 'hidden'} bg-white/10 backdrop-blur-sm rounded-[40px] md:p-6 sm:p-5 p-4 mx-auto md:max-w-[400px] sm:max-w-[350px] max-w-[300px] w-full border border-white/20 md:shadow-xl sm:shadow-lg shadow-md`}>
                  <h3 class="md:text-xl text-lg font-bold text-white mb-3 lg:text-left lg:px-0 px-4 text-center">{testimonial.title}</h3>
                  <p class="text-white/90 leading-relaxed mb-4 md:text-sm text-xs custom-scrollbar overflow-y-auto md:max-h-[100px] max-h-[80px] lg:text-left lg:px-0 px-4 text-center">{testimonial.content}</p>
                  <p class="text-white/70 md:text-sm text-xs font-medium lg:text-left lg:px-0 px-4 text-center">{testimonial.author}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      <div class="swiper-button-prev lg:left-[calc(50%-900px)] left-4"></div>
      <div class="swiper-button-next lg:right-[calc(50%-900px)] right-4"></div>
    </div>

    <!-- Decorative images -->
    <!-- Gimnastyczka - widoczna na wszystkich rozdzielczościach, nad nagłówkiem na małych ekranach -->
    <Image
      src="/images/arts/art3.png"
      alt="Decorative gymnast"
      width={448}
      height={448}
      class="absolute lg:left-[33px] md:left-[20px] sm:left-[20px] left-[20px] lg:top-12 md:top-[-10px] sm:top-[-5px] top-[-80px] z-10 transition-transform duration-500 lg:hover:scale-110 lg:pointer-events-auto pointer-events-none lg:w-[320px] lg:h-[320px] xl:w-[300px] xl:h-[300px] 2xl:w-[360px] 2xl:h-[360px] min-[1700px]:w-[448px] min-[1700px]:h-[448px] md:w-[280px] md:h-[280px] sm:w-[160px] sm:h-[160px] w-[140px] h-[140px]"
    />
    <!-- Kółka gimnastyczne - ukryte na mniejszych rozdzielczościach -->
    <Image
      src="/images/arts/kola.png"
      alt="Decorative rings"
      width={473}
      height={473}
      class="absolute right-0 top-0 z-10 parallax-art6 pointer-events-none hidden lg:block lg:w-[350px] lg:h-[350px] xl:w-[400px] xl:h-[400px] 2xl:w-[420px] 2xl:h-[420px] min-[1700px]:w-[473px] min-[1700px]:h-[473px]"
    />
  </div>
</div>

<style>
  .custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.3) transparent;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 2px;
  }

  /* Swiper styles */
  .swiper-slide {
    opacity: 0;
    transition: opacity 0.8s ease-in-out;
    cursor: grab;
  }

  .swiper-slide:active {
    cursor: grabbing;
  }

  .swiper-slide-active {
    opacity: 1;
  }

  .parallax-art6 {
    transition: transform 0.8s cubic-bezier(0.215, 0.61, 0.355, 1);
    will-change: transform;
    transform: translateX(0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .parallax-art6 {
      transition: none;
      transform: none;
    }
  }

  /* Navigation styles */
  .swiper-button-next,
  .swiper-button-prev {
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    margin: 0;
    color: white;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    backdrop-filter: blur(4px);
    transition: all 0.3s ease;
    z-index: 100;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .swiper-button-next {
    right: calc(50% - 900px);
  }

  .swiper-button-prev {
    left: calc(50% - 900px);
  }

  .swiper-button-next::after,
  .swiper-button-prev::after {
    font-size: 16px;
    font-weight: bold;
  }

  .swiper-button-next:hover,
  .swiper-button-prev:hover {
    color: #AAC9E7;
    background: rgba(255, 255, 255, 0.3);
    transform: translateY(-50%) scale(1.1);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .swiper-button-next:active,
  .swiper-button-prev:active {
    transform: translateY(-50%) scale(0.95);
  }

  @media (max-width: 1280px) {
    .swiper-button-prev { 
      left: 24px;
      z-index: 101;
    }
    .swiper-button-next { 
      right: 24px;
      z-index: 101;
    }
  }

  /* Mobile responsiveness */
  @media (max-width: 1023px) {
    .swiper-button-next,
    .swiper-button-prev {
      width: 32px;
      height: 32px;
      z-index: 102;
    }
    
    .swiper-button-next::after,
    .swiper-button-prev::after {
      font-size: 14px;
    }
  }

  @media (max-width: 639px) {
    .swiper-button-next,
    .swiper-button-prev {
      width: 28px;
      height: 28px;
      z-index: 103;
    }
    
    .swiper-button-next::after,
    .swiper-button-prev::after {
      font-size: 12px;
    }
  }

  /* Mobile testimonials cycling */
  .testimonial-mobile {
    animation: fadeIn 0.5s ease-in-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Navigation, EffectFade } from 'swiper/modules';

  // Inicjalizacja Swiper
  new Swiper('.testimonials-carousel', {
    modules: [Navigation, EffectFade],
    speed: 800,
    effect: 'fade',
    fadeEffect: {
      crossFade: true
    },
    loop: true,
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
    on: {
      init: function() {
        // Upewnij się, że przyciski nawigacji są widoczne i klikalne
        const nextBtn = document.querySelector('.swiper-button-next') as HTMLElement;
        const prevBtn = document.querySelector('.swiper-button-prev') as HTMLElement;
        
        if (nextBtn) {
          nextBtn.style.pointerEvents = 'auto';
          nextBtn.style.zIndex = '100';
        }
        if (prevBtn) {
          prevBtn.style.pointerEvents = 'auto';
          prevBtn.style.zIndex = '100';
        }
      }
    }
  });

  // Obsługa paralaksy dla poręczy gimnastycznych
  const art6Element = document.querySelector('.parallax-art6');
  let targetX = 0;
  let currentX = 0;
  let ticking = false;

  function lerp(start: number, end: number, factor: number): number {
    return start + (end - start) * factor;
  }

  function updateParallax() {
    if (art6Element) {
      // const scrolled = window.scrollY; // usunięte, nieużywane
      const windowHeight = window.innerHeight;
      const elementRect = art6Element.getBoundingClientRect();
      const elementCenter = elementRect.top + elementRect.height / 2;
      const viewportCenter = windowHeight / 2;
      
      // Obliczamy docelową pozycję
      const distanceFromCenter = elementCenter - viewportCenter;
      const maxShift = 100; // Zwiększone maksymalne przesunięcie
      targetX = (distanceFromCenter / windowHeight) * maxShift;
      
      // Płynne przejście do docelowej pozycji
      currentX = lerp(currentX, targetX, 0.05); // Zmniejszona wartość dla większego opóźnienia
      
      (art6Element as HTMLElement).style.transform = `translateX(${-currentX}px)`;

      // Kontynuuj animację, jeśli nie osiągnęliśmy celu
      if (Math.abs(targetX - currentX) > 0.1) {
        requestAnimationFrame(updateParallax);
      } else {
        ticking = false;
      }
    } else {
      ticking = false;
    }
  }

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(updateParallax);
      ticking = true;
    }
  }

  // Nasłuchiwanie zdarzeń
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  document.addEventListener('astro:page-load', () => {
    currentX = 0;
    targetX = 0;
    updateParallax();
  });

  // Inicjalne ustawienie
  if (document.readyState === 'complete') {
    updateParallax();
  } else {
    window.addEventListener('load', updateParallax);
  }

  // Obsługa cyklicznego wyświetlania opinii na urządzeniach mobilnych
  function initMobileTestimonials() {
    if (window.innerWidth < 1024) { // lg breakpoint
      const slides = document.querySelectorAll('.swiper-slide');
      
      slides.forEach(slide => {
        const testimonials = slide.querySelectorAll('.testimonial-mobile');
        if (testimonials.length > 1) {
          let currentIndex = 0;
          
          // Funkcja do przełączania opinii
          function cycleTestimonials() {
            testimonials.forEach((testimonial, index) => {
              if (index === currentIndex) {
                testimonial.classList.remove('hidden');
                testimonial.classList.add('block');
              } else {
                testimonial.classList.remove('block');
                testimonial.classList.add('hidden');
              }
            });
            
            currentIndex = (currentIndex + 1) % testimonials.length;
          }
          
          // Uruchom cykliczne przełączanie co 4 sekundy
          setInterval(cycleTestimonials, 4000);
        }
      });
    }
  }

  // Inicjalizacja po załadowaniu strony
  document.addEventListener('DOMContentLoaded', initMobileTestimonials);
  document.addEventListener('astro:page-load', initMobileTestimonials);
  
  // Reinicjalizacja po zmianie rozmiaru okna
  let resizeTimeout: NodeJS.Timeout;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(initMobileTestimonials, 250);
  });
</script>