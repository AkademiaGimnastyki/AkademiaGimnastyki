{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Astro Debug",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4321",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "/*": "${webRoot}/*"
      },
      "preLaunchTask": "npm: dev"
    },
    {
      "command": "./node_modules/.bin/astro dev",
      "name": "Development server",
      "request": "launch",
      "type": "node-terminal"
    }
  ]
}
